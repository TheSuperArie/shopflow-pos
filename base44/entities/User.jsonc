{
  "name": "User",
  "type": "object",
  "properties": {
    "access_status": {
      "type": "string",
      "enum": [
        "approved",
        "pending",
        "rejected",
        "blocked"
      ],
      "description": "\u05d0\u05d9\u05e9\u05d5\u05e8 \u05d2\u05d9\u05e9\u05d4 \u05dc\u05d0\u05ea\u05e8 \u2014 \u05e0\u05e7\u05d1\u05e2 \u05e8\u05e7 \u05e2\"\u05d9 \u05d4\u05de\u05e4\u05ea\u05d7 \u05d3\u05e8\u05da backend function. \u05e8\u05e7 'approved' \u05de\u05d0\u05e4\u05e9\u05e8 \u05e7\u05e8\u05d9\u05d0\u05d4/\u05db\u05ea\u05d9\u05d1\u05d4 \u05d1\u05e0\u05ea\u05d5\u05e0\u05d9 \u05d4\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4"
    }
  }
}