{
  "name": "BranchGeneralChat",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string",
      "description": "מזהה הסניף"
    },
    "tenant_email": {
      "type": "string",
      "description": "האימייל של הטנאנט (בעל הרשת)"
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "BRANCH",
        "HQ"
      ],
      "description": "מי שלח: BRANCH = הסניף, HQ = המטה"
    },
    "message_text": {
      "type": "string",
      "description": "תוכן ההודעה"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "האם נקרא על ידי הצד השני"
    },
    "station_email": {
      "type": "string",
      "description": "אימייל החשבון של הצד השני בצ'אט עם הרשת — חשבון הסניף, או חשבון המחסן בצ'אט רשת↔מחסן. שדה בעלות להרשאות"
    }
  },
  "required": [
    "branch_id",
    "tenant_email",
    "sender_role",
    "message_text"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    }
  }
}