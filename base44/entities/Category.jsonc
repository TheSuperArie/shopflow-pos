{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Category name"
    },
    "icon": {
      "type": "string",
      "description": "Icon name from lucide"
    },
    "parent_id": {
      "type": "string",
      "description": "Optional parent category ID for sub-categories"
    },
    "inherit_dimensions": {
      "type": "boolean",
      "default": true,
      "description": "When true, sub-category uses parent's VariantDimensions instead of its own"
    },
    "is_shirts": {
      "type": "boolean",
      "default": false,
      "description": "Whether this category is for shirts with special fields"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "source_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e8\u05e9\u05d5\u05de\u05d4 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9\u05ea \u05e9\u05de\u05de\u05e0\u05d4 \u05d4\u05d5\u05e2\u05ea\u05e7\u05d4 \u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05d6\u05d5 \u05d1\u05e9\u05d9\u05ea\u05d5\u05e3 \u05e7\u05d8\u05dc\u05d5\u05d2 \u2014 null = \u05de\u05e7\u05d5\u05e8\u05d9\u05ea"
    }
  },
  "required": [
    "name"
  ]
}