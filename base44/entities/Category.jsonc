{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Category name"
    },
    "icon": {
      "type": "string",
      "description": "Icon name from lucide"
    },
    "parent_id": {
      "type": "string",
      "description": "Optional parent category ID for sub-categories"
    },
    "inherit_dimensions": {
      "type": "boolean",
      "default": true,
      "description": "When true, sub-category uses parent's VariantDimensions instead of its own"
    },
    "is_shirts": {
      "type": "boolean",
      "default": false,
      "description": "Whether this category is for shirts with special fields"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "branch_id": {
      "type": "string",
      "description": "מזהה הסניף שהקטגוריה נוצרה עבורו על ידי מנהל הרשת — הקופה של הסניף טוענת גם קטגוריות אלה. null = קטגוריה של החשבון עצמו"
    },
    "source_id": {
      "type": "string",
      "description": "מזהה הרשומה המקורית שממנה הועתקה קטגוריה זו בשיתוף קטלוג — null = מקורית"
    },
    "station_email": {
      "type": "string",
      "description": "אימייל חשבון העמדה של הסניף — שדה בעלות להרשאות"
    },
    "tenant_email": {
      "type": "string",
      "description": "אימייל בעל הרשת. ריק = חנות יחידה — שדה בעלות להרשאות"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    }
  }
}