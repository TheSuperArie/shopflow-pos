{
  "name": "OwnerWithdrawal",
  "type": "object",
  "properties": {
    "amount": {
      "type": "number",
      "description": "סכום שנמשך מהקופה"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "תאריך המשיכה"
    },
    "notes": {
      "type": "string",
      "description": "הערה"
    },
    "branch_id": {
      "type": "string",
      "description": "מזהה הסניף (FK to Branch)"
    },
    "station_email": {
      "type": "string",
      "description": "אימייל חשבון העמדה של הסניף — שדה בעלות להרשאות"
    },
    "tenant_email": {
      "type": "string",
      "description": "אימייל בעל הרשת — שדה בעלות להרשאות"
    }
  },
  "required": [
    "amount",
    "date"
  ]
}