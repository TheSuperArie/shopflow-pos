{
  "name": "WarehouseStockMovement",
  "type": "object",
  "properties": {
    "warehouse_id": {
      "type": "string",
      "description": "\u05d4\u05de\u05d7\u05e1\u05df (FK to Warehouse)"
    },
    "stock_id": {
      "type": "string",
      "description": "\u05e9\u05d5\u05e8\u05ea \u05d4\u05de\u05dc\u05d0\u05d9 (WarehouseStock)"
    },
    "variant_id": {
      "type": "string",
      "description": "\u05d4\u05d5\u05e8\u05d9\u05d0\u05e6\u05d9\u05d4 \u05e9\u05dc \u05d4\u05e8\u05e9\u05ea"
    },
    "local_product_id": {
      "type": "string",
      "description": "\u05de\u05d5\u05e6\u05e8 \u05de\u05e7\u05d5\u05de\u05d9 \u05e9\u05dc \u05d4\u05de\u05d7\u05e1\u05df"
    },
    "product_name": {
      "type": "string"
    },
    "variant_label": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "RECEIPT",
        "PICK",
        "COUNT",
        "ADJUST"
      ],
      "description": "RECEIPT = \u05e7\u05dc\u05d9\u05d8\u05ea \u05e1\u05d7\u05d5\u05e8\u05d4, PICK = \u05dc\u05d9\u05e7\u05d5\u05d8 \u05dc\u05d4\u05d6\u05de\u05e0\u05d4, COUNT = \u05e1\u05e4\u05d9\u05e8\u05ea \u05de\u05dc\u05d0\u05d9, ADJUST = \u05ea\u05d9\u05e7\u05d5\u05df \u05d9\u05d3\u05e0\u05d9"
    },
    "qty_change": {
      "type": "number",
      "description": "\u05d4\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d1\u05db\u05de\u05d5\u05ea (+/-)"
    },
    "qty_after": {
      "type": "number",
      "description": "\u05d4\u05db\u05de\u05d5\u05ea \u05d0\u05d7\u05e8\u05d9 \u05d4\u05ea\u05e0\u05d5\u05e2\u05d4"
    },
    "order_id": {
      "type": "string",
      "description": "\u05d4\u05d6\u05de\u05e0\u05ea \u05d0\u05e1\u05e4\u05e7\u05d4 (SupplyOrder) \u2014 \u05d1\u05dc\u05d9\u05e7\u05d5\u05d8"
    },
    "order_number": {
      "type": "string"
    },
    "receipt_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e7\u05dc\u05d9\u05d8\u05d4 \u2014 \u05de\u05e7\u05d1\u05e5 \u05d0\u05ea \u05db\u05dc \u05d4\u05e9\u05d5\u05e8\u05d5\u05ea \u05e9\u05e0\u05e7\u05dc\u05d8\u05d5 \u05d9\u05d7\u05d3"
    },
    "supplier_name": {
      "type": "string",
      "description": "\u05e1\u05e4\u05e7 (\u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9)"
    },
    "delivery_note": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05ea\u05e2\u05d5\u05d3\u05ea \u05de\u05e9\u05dc\u05d5\u05d7 (\u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9)"
    },
    "notes": {
      "type": "string"
    },
    "performed_by": {
      "type": "string",
      "description": "\u05de\u05d9 \u05d1\u05d9\u05e6\u05e2"
    },
    "date": {
      "type": "string",
      "description": "\u05de\u05d5\u05e2\u05d3 \u05d4\u05ea\u05e0\u05d5\u05e2\u05d4 ISO"
    },
    "tenant_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d1\u05e2\u05dc \u05d4\u05e8\u05e9\u05ea \u2014 \u05e9\u05d3\u05d4 \u05d1\u05e2\u05dc\u05d5\u05ea \u05dc\u05d4\u05e8\u05e9\u05d0\u05d5\u05ea"
    },
    "station_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d7\u05e9\u05d1\u05d5\u05df \u05d4\u05de\u05d7\u05e1\u05df \u2014 \u05e9\u05d3\u05d4 \u05d1\u05e2\u05dc\u05d5\u05ea \u05dc\u05d4\u05e8\u05e9\u05d0\u05d5\u05ea"
    }
  },
  "required": [
    "warehouse_id",
    "type",
    "qty_change"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    }
  }
}