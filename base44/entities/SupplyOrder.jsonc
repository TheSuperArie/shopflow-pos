{
  "name": "SupplyOrder",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05d6\u05de\u05e0\u05d4 \u05e8\u05e5 \u05dc\u05ea\u05e6\u05d5\u05d2\u05d4 \u05d5\u05dc\u05d1\u05e8\u05e7\u05d5\u05d3"
    },
    "tenant_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d1\u05e2\u05dc \u05d4\u05e8\u05e9\u05ea"
    },
    "branch_id": {
      "type": "string",
      "description": "\u05d4\u05e1\u05e0\u05d9\u05e3 \u05e9\u05d4\u05d6\u05de\u05d9\u05df (FK to Branch)"
    },
    "branch_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e1\u05e0\u05d9\u05e3 (\u05dc\u05ea\u05e6\u05d5\u05d2\u05d4)"
    },
    "station_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d7\u05e9\u05d1\u05d5\u05df \u05d4\u05e2\u05de\u05d3\u05d4 \u05e9\u05dc \u05d4\u05e1\u05e0\u05d9\u05e3"
    },
    "warehouse_id": {
      "type": "string",
      "description": "\u05d4\u05de\u05d7\u05e1\u05df \u05e9\u05d4\u05d4\u05d6\u05de\u05e0\u05d4 \u05e9\u05d5\u05ea\u05e4\u05d4 \u05d0\u05dc\u05d9\u05d5 (FK to Warehouse)"
    },
    "status": {
      "type": "string",
      "enum": [
        "SENT_TO_NETWORK",
        "SENT_TO_WAREHOUSE",
        "PICKING",
        "PACKED",
        "READY",
        "SENT_TO_BRANCH",
        "RECEIVED",
        "CANCELLED"
      ],
      "default": "SENT_TO_NETWORK",
      "description": "SENT_TO_NETWORK = \u05de\u05de\u05ea\u05d9\u05e0\u05d4 \u05d0\u05e6\u05dc \u05d4\u05e8\u05e9\u05ea, SENT_TO_WAREHOUSE = \u05e9\u05d5\u05ea\u05e4\u05d4 \u05dc\u05de\u05d7\u05e1\u05df, PICKING = \u05d1\u05dc\u05d9\u05e7\u05d5\u05d8, PACKED = \u05d4\u05dc\u05d9\u05e7\u05d5\u05d8 \u05d4\u05e1\u05ea\u05d9\u05d9\u05dd \u05d5\u05e2\u05d5\u05d3 \u05dc\u05d0 \u05e0\u05e9\u05dc\u05d7\u05d4 \u05dc\u05e8\u05e9\u05ea, READY = \u05d4\u05de\u05d7\u05e1\u05df \u05e9\u05dc\u05d7 \u05dc\u05e8\u05e9\u05ea, SENT_TO_BRANCH = \u05e9\u05d5\u05ea\u05e4\u05d4 \u05dc\u05e1\u05e0\u05d9\u05e3, RECEIVED = \u05e0\u05e7\u05dc\u05d8\u05d4 \u05d1\u05e1\u05e0\u05d9\u05e3, CANCELLED = \u05d1\u05d5\u05d8\u05dc\u05d4"
    },
    "items": {
      "type": "array",
      "description": "\u05e9\u05d5\u05e8\u05d5\u05ea \u05d4\u05d4\u05d6\u05de\u05e0\u05d4 \u2014 \u05e9\u05d5\u05e8\u05d4 \u05dc\u05db\u05dc \u05d5\u05e8\u05d9\u05d0\u05e6\u05d9\u05d4 \u05de\u05d4\u05e7\u05d8\u05dc\u05d5\u05d2 \u05e9\u05dc \u05d4\u05e1\u05e0\u05d9\u05e3 (ProductVariant)",
      "items": {
        "type": "object",
        "properties": {
          "variant_id": {
            "type": "string",
            "description": "ProductVariant \u05e9\u05dc \u05d4\u05e1\u05e0\u05d9\u05e3"
          },
          "group_id": {
            "type": "string",
            "description": "ProductGroup"
          },
          "sku": {
            "type": "string"
          },
          "barcode": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "variant_label": {
            "type": "string",
            "description": "\u05de\u05d9\u05d3\u05d5\u05ea / \u05e2\u05e8\u05db\u05d9 \u05d4\u05de\u05de\u05d3\u05d9\u05dd"
          },
          "category_name": {
            "type": "string"
          },
          "branch_stock": {
            "type": "number",
            "description": "\u05d4\u05de\u05dc\u05d0\u05d9 \u05d1\u05e1\u05e0\u05d9\u05e3 \u05d1\u05e8\u05d2\u05e2 \u05d4\u05d4\u05d6\u05de\u05e0\u05d4"
          },
          "requested_qty": {
            "type": "number",
            "description": "\u05d4\u05db\u05de\u05d5\u05ea \u05e9\u05d4\u05e1\u05e0\u05d9\u05e3 \u05d1\u05d9\u05e7\u05e9"
          },
          "qty": {
            "type": "number",
            "description": "\u05d4\u05db\u05de\u05d5\u05ea \u05dc\u05d4\u05d6\u05de\u05e0\u05d4 \u05d0\u05d7\u05e8\u05d9 \u05e2\u05e8\u05d9\u05db\u05ea \u05d4\u05e8\u05e9\u05ea \u2014 \u05d6\u05d4 \u05de\u05d4 \u05e9\u05d4\u05de\u05d7\u05e1\u05df \u05de\u05dc\u05e7\u05d8"
          },
          "picked_qty": {
            "type": "number",
            "description": "\u05db\u05de\u05d4 \u05d4\u05de\u05d7\u05e1\u05df \u05dc\u05d9\u05e7\u05d8 \u05d1\u05e4\u05d5\u05e2\u05dc"
          },
          "received_qty": {
            "type": "number",
            "description": "\u05db\u05de\u05d4 \u05d4\u05e1\u05e0\u05d9\u05e3 \u05e7\u05dc\u05d8 \u05d1\u05e4\u05d5\u05e2\u05dc"
          },
          "group_barcode": {
            "type": "string",
            "description": "\u05d1\u05e8\u05e7\u05d5\u05d3 \u05db\u05dc\u05dc\u05d9 \u05e9\u05dc \u05d4\u05de\u05d5\u05e6\u05e8 (ProductGroup)"
          },
          "extra": {
            "type": "boolean",
            "description": "\u05e9\u05d5\u05e8\u05d4 \u05e9\u05d4\u05de\u05d7\u05e1\u05df \u05d4\u05d5\u05e1\u05d9\u05e3 \u05d1\u05dc\u05d9\u05e7\u05d5\u05d8 \u2014 \u05dc\u05d0 \u05d4\u05d9\u05d9\u05ea\u05d4 \u05d1\u05d4\u05d6\u05de\u05e0\u05d4"
          },
          "picked_at": {
            "type": "string",
            "description": "\u05de\u05ea\u05d9 \u05d4\u05e9\u05d5\u05e8\u05d4 \u05d0\u05d5\u05e9\u05e8\u05d4 \u05d1\u05dc\u05d9\u05e7\u05d5\u05d8"
          },
          "stock_applied": {
            "type": "boolean",
            "description": "\u05d4\u05db\u05de\u05d5\u05ea \u05e9\u05e0\u05e7\u05dc\u05d8\u05d4 \u05db\u05d1\u05e8 \u05e0\u05d5\u05e1\u05e4\u05d4 \u05dc\u05de\u05dc\u05d0\u05d9 \u05d4\u05e1\u05e0\u05d9\u05e3 (\u05de\u05d5\u05e0\u05e2 \u05db\u05e4\u05d9\u05dc\u05d5\u05ea \u05d1\u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05d7\u05d5\u05d6\u05e8)"
          },
          "network_variant_id": {
            "type": "string",
            "description": "\u05d4\u05d5\u05e8\u05d9\u05d0\u05e6\u05d9\u05d4 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9\u05ea \u05e9\u05dc \u05d4\u05e8\u05e9\u05ea (source_id \u05e9\u05dc \u05d5\u05e8\u05d9\u05d0\u05e6\u05d9\u05d9\u05ea \u05d4\u05e1\u05e0\u05d9\u05e3, \u05d0\u05d5 \u05d4\u05d5\u05e8\u05d9\u05d0\u05e6\u05d9\u05d4 \u05e2\u05e6\u05de\u05d4) \u2014 \u05dc\u05e4\u05d9\u05d4 \u05de\u05e0\u05d5\u05d4\u05dc \u05de\u05dc\u05d0\u05d9 \u05d4\u05de\u05d7\u05e1\u05df"
          },
          "warehouse_deducted": {
            "type": "number",
            "description": "\u05d9\u05e9\u05df \u2014 \u05db\u05de\u05d4 \u05d4\u05d5\u05e8\u05d3 \u05de\u05de\u05dc\u05d0\u05d9 \u05d4\u05de\u05d7\u05e1\u05df \u05e2\u05d1\u05d5\u05e8 \u05d4\u05e9\u05d5\u05e8\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05e9\u05d4\u05e0\u05d9\u05db\u05d5\u05d9 \u05e2\u05d1\u05e8 \u05dc\u05e9\u05e8\u05ea. \u05d4\u05d9\u05d5\u05dd \u05e0\u05e9\u05de\u05e8 \u05d1-stock_deducted"
          }
        }
      }
    },
    "pick_version": {
      "type": "number",
      "description": "\u05d2\u05e8\u05e1\u05ea \u05d4\u05dc\u05d9\u05e7\u05d5\u05d8 \u2014 \u05e2\u05d5\u05dc\u05d4 \u05d1\u05db\u05dc '\u05e1\u05d9\u05d9\u05dd \u05d4\u05d6\u05de\u05e0\u05d4'. \u05de\u05d6\u05d4\u05d4 \u05d4\u05d6\u05de\u05e0\u05d4 + \u05d2\u05e8\u05e1\u05d4 = \u05de\u05e4\u05ea\u05d7 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05dc\u05e0\u05d9\u05db\u05d5\u05d9"
    },
    "stock_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "DONE"
      ],
      "description": "PENDING = \u05de\u05de\u05ea\u05d9\u05df \u05dc\u05e2\u05d3\u05db\u05d5\u05df \u05de\u05dc\u05d0\u05d9 \u05d4\u05de\u05d7\u05e1\u05df (\u05d9\u05e9 \u05db\u05e4\u05ea\u05d5\u05e8 '\u05d4\u05e9\u05dc\u05dd \u05e2\u05d3\u05db\u05d5\u05df \u05de\u05dc\u05d0\u05d9'), DONE = \u05d4\u05de\u05dc\u05d0\u05d9 \u05e2\u05d5\u05d3\u05db\u05df. \u05e0\u05db\u05ea\u05d1 \u05e8\u05e7 \u05d1\u05e9\u05e8\u05ea"
    },
    "stock_deducted": {
      "type": "object",
      "description": "\u05db\u05de\u05d4 \u05db\u05d1\u05e8 \u05d4\u05d5\u05e8\u05d3 \u05de\u05de\u05dc\u05d0\u05d9 \u05d4\u05de\u05d7\u05e1\u05df \u05dc\u05db\u05dc \u05d5\u05e8\u05d9\u05d0\u05e6\u05d9\u05d9\u05ea \u05e1\u05e0\u05d9\u05e3 { variant_id: qty } \u2014 \u05e0\u05db\u05ea\u05d1 \u05e8\u05e7 \u05d1\u05e9\u05e8\u05ea \u05d0\u05d7\u05e8\u05d9 \u05e9\u05d4\u05de\u05dc\u05d0\u05d9 \u05e2\u05d5\u05d3\u05db\u05df"
    },
    "branch_notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05d4\u05e1\u05e0\u05d9\u05e3"
    },
    "network_notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05d4\u05e8\u05e9\u05ea \u05dc\u05de\u05d7\u05e1\u05df"
    },
    "warehouse_notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05d4\u05de\u05d7\u05e1\u05df \u05d1\u05e1\u05d9\u05d5\u05dd \u05dc\u05d9\u05e7\u05d5\u05d8"
    },
    "picker_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05dc\u05e7\u05d8"
    },
    "sent_to_network_at": {
      "type": "string",
      "description": "\u05de\u05ea\u05d9 \u05d4\u05e1\u05e0\u05d9\u05e3 \u05e9\u05dc\u05d7"
    },
    "sent_to_warehouse_at": {
      "type": "string",
      "description": "\u05de\u05ea\u05d9 \u05d4\u05e8\u05e9\u05ea \u05e9\u05d9\u05ea\u05e4\u05d4 \u05dc\u05de\u05d7\u05e1\u05df"
    },
    "ready_at": {
      "type": "string",
      "description": "\u05de\u05ea\u05d9 \u05d4\u05de\u05d7\u05e1\u05df \u05e1\u05d9\u05d9\u05dd \u05dc\u05d9\u05e7\u05d5\u05d8"
    },
    "sent_to_branch_at": {
      "type": "string",
      "description": "\u05de\u05ea\u05d9 \u05d4\u05e8\u05e9\u05ea \u05e9\u05d9\u05ea\u05e4\u05d4 \u05dc\u05e1\u05e0\u05d9\u05e3"
    },
    "received_at": {
      "type": "string",
      "description": "\u05de\u05ea\u05d9 \u05d4\u05e1\u05e0\u05d9\u05e3 \u05e7\u05dc\u05d8"
    },
    "picking_started_at": {
      "type": "string",
      "description": "\u05de\u05ea\u05d9 \u05d4\u05ea\u05d7\u05d9\u05dc \u05d4\u05dc\u05d9\u05e7\u05d5\u05d8"
    },
    "received_by": {
      "type": "string",
      "description": "\u05d4\u05d7\u05e9\u05d1\u05d5\u05df \u05e9\u05e7\u05dc\u05d8 \u05d0\u05ea \u05d4\u05de\u05e9\u05dc\u05d5\u05d7 \u05d1\u05e1\u05e0\u05d9\u05e3"
    }
  },
  "required": [
    "tenant_email",
    "branch_id",
    "status"
  ]
}