{
  "name": "ProductVariant",
  "properties": {
    "branch_id": {
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e1\u05e0\u05d9\u05e3 \u05e9\u05d4\u05d5\u05e8\u05d9\u05d0\u05e6\u05d9\u05d4 \u05e0\u05d5\u05e6\u05e8\u05d4 \u05e2\u05d1\u05d5\u05e8\u05d5 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05de\u05e0\u05d4\u05dc \u05d4\u05e8\u05e9\u05ea \u2014 \u05d4\u05e7\u05d5\u05e4\u05d4 \u05e9\u05dc \u05d4\u05e1\u05e0\u05d9\u05e3 \u05d8\u05d5\u05e2\u05e0\u05ea \u05d2\u05dd \u05d5\u05e8\u05d9\u05d0\u05e6\u05d9\u05d5\u05ea \u05d0\u05dc\u05d4. null = \u05d5\u05e8\u05d9\u05d0\u05e6\u05d9\u05d4 \u05e9\u05dc \u05d4\u05d7\u05e9\u05d1\u05d5\u05df \u05e2\u05e6\u05de\u05d5",
      "type": "string"
    },
    "carton_barcode": {
      "description": "\u05d4\u05d1\u05e8\u05e7\u05d5\u05d3 \u05e9\u05e2\u05dc \u05de\u05d3\u05d1\u05e7\u05ea \u05d4\u05e7\u05e8\u05d8\u05d5\u05df \u05e9\u05dc \u05d4\u05d5\u05e8\u05d9\u05d0\u05e6\u05d9\u05d4 (\u05e7\u05e8\u05d8\u05d5\u05df \u05e9\u05dc \u05de\u05d9\u05d3\u05d4 \u05d0\u05d7\u05ea \u05db\u05e4\u05d9 \u05e9\u05de\u05d2\u05d9\u05e2 \u05de\u05d4\u05d9\u05e6\u05e8\u05df). \u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9",
      "type": "string"
    },
    "carton_number": {
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05e7\u05e8\u05d8\u05d5\u05df \u05d1\u05de\u05d7\u05e1\u05df (\u05d4\u05d3\u05d2\u05dd \u2014 \u05db\u05dc \u05d4\u05de\u05d9\u05d3\u05d5\u05ea \u05e9\u05dc \u05d4\u05d3\u05d2\u05dd \u05d1\u05d0\u05d5\u05ea\u05d5 \u05de\u05e1\u05e4\u05e8 \u05e7\u05e8\u05d8\u05d5\u05df). \u05d8\u05e7\u05e1\u05d8 \u05d7\u05d5\u05e4\u05e9\u05d9, \u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9",
      "type": "string"
    },
    "cost_price": {
      "description": "\u05de\u05d7\u05d9\u05e8 \u05e2\u05dc\u05d5\u05ea (\u05e8\u05e7 \u05d0\u05dd \u05d4\u05de\u05d5\u05e6\u05e8 \u05dc\u05d0 \u05d1\u05de\u05d7\u05d9\u05e8 \u05d0\u05d7\u05d9\u05d3)",
      "type": "number"
    },
    "dimensions": {
      "description": "\u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 \u05e9\u05dc \u05de\u05de\u05d3\u05d9\u05dd \u05d5\u05e2\u05e8\u05db\u05d9\u05dd (\u05dc\u05d3\u05d5\u05d2\u05de\u05d4: {size: '15', color: '\u05db\u05d7\u05d5\u05dc', collar: '\u05d0\u05de\u05e8\u05d9\u05e7\u05d0\u05d9'})",
      "type": "object"
    },
    "group_id": {
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05ea\u05d9\u05e7\u05d9\u05d9\u05d4",
      "type": "string"
    },
    "sell_price": {
      "description": "\u05de\u05d7\u05d9\u05e8 \u05de\u05db\u05d9\u05e8\u05d4 (\u05e8\u05e7 \u05d0\u05dd \u05d4\u05de\u05d5\u05e6\u05e8 \u05dc\u05d0 \u05d1\u05de\u05d7\u05d9\u05e8 \u05d0\u05d7\u05d9\u05d3)",
      "type": "number"
    },
    "sku": {
      "description": "\u05de\u05e7\"\u05d8 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9",
      "type": "string"
    },
    "source_id": {
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e8\u05e9\u05d5\u05de\u05d4 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9\u05ea \u05e9\u05de\u05de\u05e0\u05d4 \u05d4\u05d5\u05e2\u05ea\u05e7\u05d4 \u05d5\u05e8\u05d9\u05d0\u05e6\u05d9\u05d4 \u05d6\u05d5 \u05d1\u05e9\u05d9\u05ea\u05d5\u05e3 \u05e7\u05d8\u05dc\u05d5\u05d2 \u2014 null = \u05de\u05e7\u05d5\u05e8\u05d9\u05ea",
      "type": "string"
    },
    "station_email": {
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d7\u05e9\u05d1\u05d5\u05df \u05d4\u05e2\u05de\u05d3\u05d4 \u05e9\u05dc \u05d4\u05e1\u05e0\u05d9\u05e3 \u2014 \u05e9\u05d3\u05d4 \u05d1\u05e2\u05dc\u05d5\u05ea \u05dc\u05d4\u05e8\u05e9\u05d0\u05d5\u05ea",
      "type": "string"
    },
    "stock": {
      "default": 0,
      "description": "\u05de\u05dc\u05d0\u05d9",
      "type": "number"
    },
    "tenant_email": {
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d1\u05e2\u05dc \u05d4\u05e8\u05e9\u05ea. \u05e8\u05d9\u05e7 = \u05d7\u05e0\u05d5\u05ea \u05d9\u05d7\u05d9\u05d3\u05d4 \u2014 \u05e9\u05d3\u05d4 \u05d1\u05e2\u05dc\u05d5\u05ea \u05dc\u05d4\u05e8\u05e9\u05d0\u05d5\u05ea",
      "type": "string"
    }
  },
  "required": [
    "group_id",
    "dimensions"
  ],
  "type": "object",
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    }
  }
}