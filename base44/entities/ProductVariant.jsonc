{
  "name": "ProductVariant",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "מזהה התיקייה"
    },
    "dimensions": {
      "type": "object",
      "description": "אובייקט של ממדים וערכים (לדוגמה: {size: '15', color: 'כחול', collar: 'אמריקאי'})"
    },
    "stock": {
      "type": "number",
      "default": 0,
      "description": "מלאי"
    },
    "sell_price": {
      "type": "number",
      "description": "מחיר מכירה (רק אם המוצר לא במחיר אחיד)"
    },
    "cost_price": {
      "type": "number",
      "description": "מחיר עלות (רק אם המוצר לא במחיר אחיד)"
    },
    "sku": {
      "type": "string",
      "description": "מק\"ט ייחודי"
    },
    "branch_id": {
      "type": "string",
      "description": "מזהה הסניף שהוריאציה נוצרה עבורו על ידי מנהל הרשת — הקופה של הסניף טוענת גם וריאציות אלה. null = וריאציה של החשבון עצמו"
    },
    "source_id": {
      "type": "string",
      "description": "מזהה הרשומה המקורית שממנה הועתקה וריאציה זו בשיתוף קטלוג — null = מקורית"
    },
    "station_email": {
      "type": "string",
      "description": "אימייל חשבון העמדה של הסניף — שדה בעלות להרשאות"
    },
    "tenant_email": {
      "type": "string",
      "description": "אימייל בעל הרשת. ריק = חנות יחידה — שדה בעלות להרשאות"
    }
  },
  "required": [
    "group_id",
    "dimensions"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    }
  }
}