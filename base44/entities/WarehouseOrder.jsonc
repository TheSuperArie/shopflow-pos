{
  "name": "WarehouseOrder",
  "type": "object",
  "properties": {
    "tenant_email": {
      "type": "string",
      "description": "האימייל של בעל הרשת שיצר את ההזמנה למחסן — לסינון בצד הקליינט"
    },
    "order_number": {
      "type": "string",
      "description": "מספר הזמנה לתצוגה ולמעקב"
    },
    "order_date": {
      "type": "string",
      "format": "date",
      "description": "תאריך שליחת ההזמנה למחסן"
    },
    "status": {
      "type": "string",
      "enum": [
        "הוזמן",
        "בוטל"
      ],
      "default": "הוזמן",
      "description": "סטטוס ההזמנה. קליטת סחורה בפועל אינה בתחום המסך הזה"
    },
    "total_qty": {
      "type": "number",
      "description": "סך כל היחידות בהזמנה"
    },
    "total_items": {
      "type": "number",
      "description": "מספר שורות (פריטים שונים) בהזמנה"
    },
    "notes": {
      "type": "string",
      "description": "הערות להזמנה"
    },
    "items": {
      "type": "array",
      "description": "שורות ההזמנה — פריט אחד לכל וריאציה, עם הפילוח לפי סניפים",
      "items": {
        "type": "object",
        "properties": {
          "variant_id": {
            "type": "string"
          },
          "variant_label": {
            "type": "string"
          },
          "qty": {
            "type": "number",
            "description": "הכמות הסופית שהוזמנה (לאחר עריכה של מנהל הרשת)"
          },
          "requested_qty": {
            "type": "number",
            "description": "הכמות המצטברת שהסניפים ביקשו במקור"
          },
          "branches": {
            "type": "array",
            "description": "פילוח הבקשה לפי סניף",
            "items": {
              "type": "object",
              "properties": {
                "branch_id": {
                  "type": "string"
                },
                "branch_name": {
                  "type": "string"
                },
                "qty": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "request_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "מזהי בקשות המלאי (StockRequest) שנכללו בהזמנה — כדי שלא יופיעו שוב בריכוז הבא"
    }
  },
  "required": [
    "tenant_email",
    "order_date",
    "items"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    }
  }
}