{
  "name": "WarehouseOrder",
  "type": "object",
  "properties": {
    "tenant_email": {
      "type": "string",
      "description": "\u05d4\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05e9\u05dc \u05d1\u05e2\u05dc \u05d4\u05e8\u05e9\u05ea \u05e9\u05d9\u05e6\u05e8 \u05d0\u05ea \u05d4\u05d4\u05d6\u05de\u05e0\u05d4 \u05dc\u05de\u05d7\u05e1\u05df \u2014 \u05dc\u05e1\u05d9\u05e0\u05d5\u05df \u05d1\u05e6\u05d3 \u05d4\u05e7\u05dc\u05d9\u05d9\u05e0\u05d8"
    },
    "order_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05d6\u05de\u05e0\u05d4 \u05dc\u05ea\u05e6\u05d5\u05d2\u05d4 \u05d5\u05dc\u05de\u05e2\u05e7\u05d1"
    },
    "order_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e9\u05dc\u05d9\u05d7\u05ea \u05d4\u05d4\u05d6\u05de\u05e0\u05d4 \u05dc\u05de\u05d7\u05e1\u05df"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u05d4\u05d5\u05d6\u05de\u05df",
        "\u05d1\u05d5\u05d8\u05dc"
      ],
      "default": "\u05d4\u05d5\u05d6\u05de\u05df",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d4\u05d6\u05de\u05e0\u05d4. \u05e7\u05dc\u05d9\u05d8\u05ea \u05e1\u05d7\u05d5\u05e8\u05d4 \u05d1\u05e4\u05d5\u05e2\u05dc \u05d0\u05d9\u05e0\u05d4 \u05d1\u05ea\u05d7\u05d5\u05dd \u05d4\u05de\u05e1\u05da \u05d4\u05d6\u05d4"
    },
    "total_qty": {
      "type": "number",
      "description": "\u05e1\u05da \u05db\u05dc \u05d4\u05d9\u05d7\u05d9\u05d3\u05d5\u05ea \u05d1\u05d4\u05d6\u05de\u05e0\u05d4"
    },
    "total_items": {
      "type": "number",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05e9\u05d5\u05e8\u05d5\u05ea (\u05e4\u05e8\u05d9\u05d8\u05d9\u05dd \u05e9\u05d5\u05e0\u05d9\u05dd) \u05d1\u05d4\u05d6\u05de\u05e0\u05d4"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05dc\u05d4\u05d6\u05de\u05e0\u05d4"
    },
    "items": {
      "type": "array",
      "description": "\u05e9\u05d5\u05e8\u05d5\u05ea \u05d4\u05d4\u05d6\u05de\u05e0\u05d4 \u2014 \u05e4\u05e8\u05d9\u05d8 \u05d0\u05d7\u05d3 \u05dc\u05db\u05dc \u05d5\u05e8\u05d9\u05d0\u05e6\u05d9\u05d4, \u05e2\u05dd \u05d4\u05e4\u05d9\u05dc\u05d5\u05d7 \u05dc\u05e4\u05d9 \u05e1\u05e0\u05d9\u05e4\u05d9\u05dd",
      "items": {
        "type": "object",
        "properties": {
          "variant_id": {
            "type": "string"
          },
          "variant_label": {
            "type": "string"
          },
          "qty": {
            "type": "number",
            "description": "\u05d4\u05db\u05de\u05d5\u05ea \u05d4\u05e1\u05d5\u05e4\u05d9\u05ea \u05e9\u05d4\u05d5\u05d6\u05de\u05e0\u05d4 (\u05dc\u05d0\u05d7\u05e8 \u05e2\u05e8\u05d9\u05db\u05d4 \u05e9\u05dc \u05de\u05e0\u05d4\u05dc \u05d4\u05e8\u05e9\u05ea)"
          },
          "requested_qty": {
            "type": "number",
            "description": "\u05d4\u05db\u05de\u05d5\u05ea \u05d4\u05de\u05e6\u05d8\u05d1\u05e8\u05ea \u05e9\u05d4\u05e1\u05e0\u05d9\u05e4\u05d9\u05dd \u05d1\u05d9\u05e7\u05e9\u05d5 \u05d1\u05de\u05e7\u05d5\u05e8"
          },
          "branches": {
            "type": "array",
            "description": "\u05e4\u05d9\u05dc\u05d5\u05d7 \u05d4\u05d1\u05e7\u05e9\u05d4 \u05dc\u05e4\u05d9 \u05e1\u05e0\u05d9\u05e3",
            "items": {
              "type": "object",
              "properties": {
                "branch_id": {
                  "type": "string"
                },
                "branch_name": {
                  "type": "string"
                },
                "qty": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "request_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05de\u05d6\u05d4\u05d9 \u05d1\u05e7\u05e9\u05d5\u05ea \u05d4\u05de\u05dc\u05d0\u05d9 (StockRequest) \u05e9\u05e0\u05db\u05dc\u05dc\u05d5 \u05d1\u05d4\u05d6\u05de\u05e0\u05d4 \u2014 \u05db\u05d3\u05d9 \u05e9\u05dc\u05d0 \u05d9\u05d5\u05e4\u05d9\u05e2\u05d5 \u05e9\u05d5\u05d1 \u05d1\u05e8\u05d9\u05db\u05d5\u05d6 \u05d4\u05d1\u05d0"
    }
  },
  "required": [
    "tenant_email",
    "order_date",
    "items"
  ]
}