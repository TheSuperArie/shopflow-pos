{
  "name": "WarehouseStock",
  "type": "object",
  "properties": {
    "warehouse_id": {
      "type": "string",
      "description": "\u05d4\u05de\u05d7\u05e1\u05df (FK to Warehouse)"
    },
    "variant_id": {
      "type": "string",
      "description": "\u05d4\u05d5\u05e8\u05d9\u05d0\u05e6\u05d9\u05d4 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9\u05ea \u05e9\u05dc \u05d4\u05e8\u05e9\u05ea (ProductVariant). \u05e8\u05d9\u05e7 = \u05de\u05d5\u05e6\u05e8 \u05de\u05e7\u05d5\u05de\u05d9 \u05e9\u05dc \u05d4\u05de\u05d7\u05e1\u05df"
    },
    "local_product_id": {
      "type": "string",
      "description": "\u05de\u05d5\u05e6\u05e8 \u05de\u05e7\u05d5\u05de\u05d9 \u05e9\u05dc \u05d4\u05de\u05d7\u05e1\u05df (WarehouseLocalProduct) \u2014 \u05e0\u05e9\u05d0\u05e8 \u05d2\u05dd \u05d0\u05d7\u05e8\u05d9 \u05e9\u05e7\u05d5\u05e9\u05e8 \u05dc\u05de\u05d5\u05e6\u05e8 \u05e8\u05e9\u05ea"
    },
    "product_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d5\u05e6\u05e8 (\u05dc\u05ea\u05e6\u05d5\u05d2\u05d4)"
    },
    "variant_label": {
      "type": "string",
      "description": "\u05de\u05d9\u05d3\u05d4 / \u05e2\u05e8\u05db\u05d9 \u05d4\u05de\u05de\u05d3\u05d9\u05dd (\u05dc\u05ea\u05e6\u05d5\u05d2\u05d4)"
    },
    "category_name": {
      "type": "string",
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 (\u05dc\u05ea\u05e6\u05d5\u05d2\u05d4 \u05d5\u05dc\u05e1\u05d9\u05e0\u05d5\u05df)"
    },
    "sku": {
      "type": "string"
    },
    "qty": {
      "type": "number",
      "default": 0,
      "description": "\u05d4\u05db\u05de\u05d5\u05ea \u05d1\u05de\u05d7\u05e1\u05df \u2014 \u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d9\u05d5\u05ea \u05e9\u05dc\u05d9\u05dc\u05d9\u05ea"
    },
    "tenant_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d1\u05e2\u05dc \u05d4\u05e8\u05e9\u05ea \u2014 \u05e9\u05d3\u05d4 \u05d1\u05e2\u05dc\u05d5\u05ea \u05dc\u05d4\u05e8\u05e9\u05d0\u05d5\u05ea"
    },
    "station_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d7\u05e9\u05d1\u05d5\u05df \u05d4\u05de\u05d7\u05e1\u05df \u2014 \u05e9\u05d3\u05d4 \u05d1\u05e2\u05dc\u05d5\u05ea \u05dc\u05d4\u05e8\u05e9\u05d0\u05d5\u05ea"
    }
  },
  "required": [
    "warehouse_id",
    "qty"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    }
  }
}