{
  "name": "VariantDimension",
  "type": "object",
  "properties": {
    "category_id": {
      "type": "string",
      "description": "הקטגוריה שאליה שייך הממד"
    },
    "name": {
      "type": "string",
      "description": "שם הממד (לדוגמה: צבע, גודל, צווארון)"
    },
    "values": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "ערכים אפשריים לממד"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "האם הממד פעיל"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "סדר הצגה"
    },
    "source_id": {
      "type": "string",
      "description": "מזהה הרשומה המקורית שממנה הועתק ממד זה בשיתוף קטלוג — null = מקורי"
    },
    "branch_id": {
      "type": "string",
      "description": "מזהה הסניף (FK to Branch)"
    },
    "station_email": {
      "type": "string",
      "description": "אימייל חשבון העמדה של הסניף — שדה בעלות להרשאות"
    },
    "tenant_email": {
      "type": "string",
      "description": "אימייל בעל הרשת. ריק = חנות יחידה — שדה בעלות להרשאות"
    }
  },
  "required": [
    "category_id",
    "name",
    "values"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    }
  }
}