{
  "name": "Credit",
  "properties": {
    "amount": {
      "description": "\u05e1\u05db\u05d5\u05dd \u05d4\u05d6\u05d9\u05db\u05d5\u05d9",
      "type": "number"
    },
    "balance": {
      "description": "\u05d9\u05ea\u05e8\u05d4 \u05d6\u05de\u05d9\u05e0\u05d4",
      "type": "number"
    },
    "branch_id": {
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e1\u05e0\u05d9\u05e3 (FK to Branch)",
      "type": "string"
    },
    "customer_email": {
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d4\u05dc\u05e7\u05d5\u05d7",
      "type": "string"
    },
    "customer_name": {
      "description": "\u05e9\u05dd \u05d4\u05dc\u05e7\u05d5\u05d7",
      "type": "string"
    },
    "customer_phone": {
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df \u05d4\u05dc\u05e7\u05d5\u05d7",
      "type": "string"
    },
    "expiry_date": {
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05ea\u05e4\u05d5\u05d2\u05d4",
      "format": "date",
      "type": "string"
    },
    "notes": {
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea",
      "type": "string"
    },
    "return_id": {
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d4\u05d7\u05d6\u05e8\u05d4 \u05e9\u05d9\u05e6\u05e8\u05d4 \u05d0\u05ea \u05d4\u05d6\u05d9\u05db\u05d5\u05d9",
      "type": "string"
    },
    "station_email": {
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d7\u05e9\u05d1\u05d5\u05df \u05d4\u05e2\u05de\u05d3\u05d4 \u05e9\u05dc \u05d4\u05e1\u05e0\u05d9\u05e3 \u2014 \u05e9\u05d3\u05d4 \u05d1\u05e2\u05dc\u05d5\u05ea \u05dc\u05d4\u05e8\u05e9\u05d0\u05d5\u05ea",
      "type": "string"
    },
    "status": {
      "default": "\u05e4\u05e2\u05d9\u05dc",
      "enum": [
        "\u05e4\u05e2\u05d9\u05dc",
        "\u05e0\u05d5\u05e6\u05dc",
        "\u05e4\u05d2 \u05ea\u05d5\u05e7\u05e3"
      ],
      "type": "string"
    },
    "tenant_email": {
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d1\u05e2\u05dc \u05d4\u05e8\u05e9\u05ea. \u05e8\u05d9\u05e7 = \u05d7\u05e0\u05d5\u05ea \u05d9\u05d7\u05d9\u05d3\u05d4 \u2014 \u05e9\u05d3\u05d4 \u05d1\u05e2\u05dc\u05d5\u05ea \u05dc\u05d4\u05e8\u05e9\u05d0\u05d5\u05ea",
      "type": "string"
    },
    "used_amount": {
      "default": 0,
      "description": "\u05e1\u05db\u05d5\u05dd \u05e9\u05db\u05d1\u05e8 \u05e0\u05d5\u05e6\u05dc",
      "type": "number"
    }
  },
  "required": [
    "amount",
    "balance"
  ],
  "rls": {
    "create": true,
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    }
  },
  "type": "object"
}