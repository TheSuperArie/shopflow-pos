{
  "name": "Expense",
  "properties": {
    "amount": {
      "type": "number"
    },
    "branch_id": {
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e1\u05e0\u05d9\u05e3 \u05d1\u05d5 \u05e0\u05e8\u05e9\u05de\u05d4 \u05d4\u05d4\u05d5\u05e6\u05d0\u05d4 (FK to Branch). null = \u05d7\u05e0\u05d5\u05ea \u05d9\u05d7\u05d9\u05d3\u05d4 / \u05e8\u05e9\u05d5\u05de\u05d4 \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05ea \u2014 \u05ea\u05d5\u05d0\u05de\u05d5\u05ea \u05dc\u05d0\u05d7\u05d5\u05e8 \u05de\u05dc\u05d0\u05d4",
      "type": "string"
    },
    "category": {
      "enum": [
        "\u05e9\u05db\u05e8 \u05e2\u05d5\u05d1\u05d3\u05d9\u05dd",
        "\u05d4\u05d5\u05e6\u05d0\u05d5\u05ea \u05d7\u05d5\u05e5",
        "\u05e4\u05e8\u05e1\u05d5\u05dd",
        "\u05db\u05d9\u05d1\u05d5\u05d3/\u05e2\u05d5\u05d2\u05d5\u05ea",
        "\u05e9\u05db\u05d9\u05e8\u05d5\u05ea \u05de\u05e9\u05e8\u05d3",
        "\u05e8\u05d5\u05d0\u05d4 \u05d7\u05e9\u05d1\u05d5\u05df/\u05d4\u05e0\u05d4\u05dc\u05ea \u05d7\u05e9\u05d1\u05d5\u05e0\u05d5\u05ea",
        "\u05e4\u05e8\u05e1\u05d5\u05dd \u05d5\u05e9\u05d9\u05d5\u05d5\u05e7",
        "\u05de\u05d7\u05e1\u05df \u05de\u05e8\u05db\u05d6\u05d9",
        "\u05ea\u05d5\u05db\u05e0\u05d4 \u05d5\u05de\u05e2\u05e8\u05db\u05d5\u05ea",
        "\u05e9\u05db\u05e8 \u05d4\u05e0\u05d4\u05dc\u05d4",
        "\u05d0\u05d7\u05e8"
      ],
      "type": "string"
    },
    "custom_category": {
      "description": "\u05e9\u05dd \u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05de\u05d5\u05ea\u05d0\u05de\u05ea \u05d0\u05d9\u05e9\u05d9\u05ea (\u05e8\u05e7 \u05d0\u05dd \u05d1\u05d7\u05e8\u05ea '\u05d0\u05d7\u05e8')",
      "type": "string"
    },
    "date": {
      "format": "date",
      "type": "string"
    },
    "deduct_from_debt": {
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05dc\u05e9\u05db\u05dc\u05dc \u05d0\u05ea \u05d4\u05d4\u05d5\u05e6\u05d0\u05d4 \u05d1\u05d7\u05d5\u05d1 \u05d4\u05d7\u05e0\u05d5\u05ea \u05dc\u05e2\u05d5\u05d1\u05d3 (\u05dc\u05d4\u05d5\u05e8\u05d9\u05d3 \u05d0\u05d5\u05ea\u05d4 \u05de\u05d4\u05e9\u05db\u05e8 \u05d4\u05de\u05d2\u05d9\u05e2 \u05dc\u05d5)",
      "type": "boolean"
    },
    "description": {
      "type": "string"
    },
    "employee_id": {
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e2\u05d5\u05d1\u05d3 \u05e9\u05d4\u05d4\u05d5\u05e6\u05d0\u05d4 \u05de\u05e9\u05d5\u05d9\u05db\u05ea \u05d0\u05dc\u05d9\u05d5 (\u05d4\u05d5\u05e6\u05d0\u05d4 \u05d0\u05d9\u05e9\u05d9\u05ea \u05e9\u05dc \u05e2\u05d5\u05d1\u05d3 / \u05de\u05e7\u05d3\u05de\u05d4). null = \u05d4\u05d5\u05e6\u05d0\u05d4 \u05db\u05dc\u05dc\u05d9\u05ea \u05e9\u05dc \u05d4\u05d7\u05e0\u05d5\u05ea",
      "type": "string"
    },
    "employee_name": {
      "description": "\u05e9\u05dd \u05d4\u05e2\u05d5\u05d1\u05d3 \u05e9\u05d4\u05d4\u05d5\u05e6\u05d0\u05d4 \u05de\u05e9\u05d5\u05d9\u05db\u05ea \u05d0\u05dc\u05d9\u05d5",
      "type": "string"
    },
    "employee_payment_id": {
      "description": "\u05de\u05d6\u05d4\u05d4 \u05ea\u05e9\u05dc\u05d5\u05dd \u05d4\u05e2\u05d5\u05d1\u05d3 (EmployeePayment) \u05e9\u05d4\u05d4\u05d5\u05e6\u05d0\u05d4 \u05de\u05e9\u05e7\u05e4\u05ea \u2014 \u05de\u05d0\u05e4\u05e9\u05e8 \u05e2\u05d3\u05db\u05d5\u05df/\u05de\u05d7\u05d9\u05e7\u05d4 \u05e9\u05dc \u05d4\u05d4\u05d5\u05e6\u05d0\u05d4 \u05d9\u05d7\u05d3 \u05e2\u05dd \u05d4\u05ea\u05e9\u05dc\u05d5\u05dd",
      "type": "string"
    },
    "expense_type": {
      "default": "\u05d7\u05d3 \u05e4\u05e2\u05de\u05d9\u05ea",
      "description": "\u05e1\u05d9\u05d5\u05d5\u05d2 \u05d4\u05d4\u05d5\u05e6\u05d0\u05d4 \u05dc\u05e6\u05d5\u05e8\u05da \u05ea\u05e6\u05d5\u05d2\u05d4 \u05d1\u05dc\u05d1\u05d3 \u2014 \u05e7\u05d1\u05d5\u05e2\u05d4 / \u05d7\u05d3 \u05e4\u05e2\u05de\u05d9\u05ea. \u05d0\u05d9\u05df \u05db\u05dc \u05d0\u05d5\u05d8\u05d5\u05de\u05e6\u05d9\u05d4 \u05d0\u05d5 \u05d7\u05d6\u05e8\u05ea\u05d9\u05d5\u05ea. \u05e8\u05e9\u05d5\u05de\u05d4 \u05dc\u05dc\u05d0 \u05e2\u05e8\u05da \u05e0\u05d7\u05e9\u05d1\u05ea \u05d7\u05d3 \u05e4\u05e2\u05de\u05d9\u05ea",
      "enum": [
        "\u05e7\u05d1\u05d5\u05e2\u05d4",
        "\u05d7\u05d3 \u05e4\u05e2\u05de\u05d9\u05ea"
      ],
      "type": "string"
    },
    "network_level": {
      "default": false,
      "description": "\u05d4\u05d5\u05e6\u05d0\u05d4 \u05e9\u05dc \u05d4\u05e8\u05e9\u05ea \u05e2\u05e6\u05de\u05d4 (\u05de\u05e9\u05e8\u05d3, \u05e8\u05d5\"\u05d7, \u05de\u05d7\u05e1\u05df \u05de\u05e8\u05db\u05d6\u05d9...) \u2014 \u05dc\u05d0 \u05e9\u05d9\u05d9\u05db\u05ea \u05dc\u05d0\u05e3 \u05e1\u05e0\u05d9\u05e3 \u05d5\u05dc\u05d0 \u05e0\u05e1\u05e4\u05e8\u05ea \u05d1\u05d7\u05d9\u05e9\u05d5\u05d1\u05d9 \u05e1\u05e0\u05d9\u05e3. \u05ea\u05de\u05d9\u05d3 \u05d9\u05d7\u05d3 \u05e2\u05dd network_only=true \u05d5\u05dc\u05dc\u05d0 branch_id",
      "type": "boolean"
    },
    "network_only": {
      "default": false,
      "description": "\u05d4\u05d5\u05e6\u05d0\u05d4 \u05e9\u05e0\u05e8\u05e9\u05de\u05d4 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05de\u05e0\u05d4\u05dc \u05d4\u05e8\u05e9\u05ea. \u05de\u05d5\u05e6\u05d2\u05ea \u05d5\u05de\u05e9\u05d5\u05db\u05dc\u05dc\u05ea \u05e8\u05e7 \u05d1\u05e6\u05d3 \u05d4\u05e8\u05e9\u05ea \u2014 \u05de\u05e0\u05d4\u05dc \u05d4\u05e1\u05e0\u05d9\u05e3 \u05d0\u05d9\u05e0\u05d5 \u05e8\u05d5\u05d0\u05d4 \u05d0\u05d5\u05ea\u05d4 \u05d1\u05d3\u05d5\u05d7\u05d5\u05ea \u05e9\u05dc\u05d5",
      "type": "boolean"
    },
    "notes": {
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05d7\u05d5\u05e4\u05e9\u05d9\u05d5\u05ea \u05e2\u05dc \u05d4\u05d4\u05d5\u05e6\u05d0\u05d4",
      "type": "string"
    },
    "station_email": {
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d7\u05e9\u05d1\u05d5\u05df \u05d4\u05e2\u05de\u05d3\u05d4 \u05e9\u05dc \u05d4\u05e1\u05e0\u05d9\u05e3 \u2014 \u05e9\u05d3\u05d4 \u05d1\u05e2\u05dc\u05d5\u05ea \u05dc\u05d4\u05e8\u05e9\u05d0\u05d5\u05ea",
      "type": "string"
    },
    "template_id": {
      "description": "\u05de\u05d6\u05d4\u05d4 \u05ea\u05d1\u05e0\u05d9\u05ea \u05d4\u05d4\u05d5\u05e6\u05d0\u05d4 \u05d4\u05e7\u05d1\u05d5\u05e2\u05d4 (FixedExpenseTemplate) \u05e9\u05de\u05de\u05e0\u05d4 \u05e0\u05e8\u05e9\u05de\u05d4 \u05d4\u05d4\u05d5\u05e6\u05d0\u05d4 \u2014 null = \u05d4\u05d5\u05e6\u05d0\u05d4 \u05d7\u05d5\u05e4\u05e9\u05d9\u05ea",
      "type": "string"
    },
    "tenant_email": {
      "description": "\u05d4\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05e9\u05dc \u05d1\u05e2\u05dc \u05d4\u05e8\u05e9\u05ea \u05e9\u05d4\u05d4\u05d5\u05e6\u05d0\u05d4 \u05e9\u05d9\u05d9\u05db\u05ea \u05dc\u05e8\u05e9\u05ea \u05e9\u05dc\u05d5 \u2014 \u05de\u05e9\u05de\u05e9 \u05d2\u05dd \u05db\u05e9\u05d3\u05d4 \u05d1\u05e2\u05dc\u05d5\u05ea \u05dc\u05d4\u05e8\u05e9\u05d0\u05d5\u05ea",
      "type": "string"
    }
  },
  "required": [
    "description",
    "amount",
    "category",
    "date"
  ],
  "rls": {
    "create": true,
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    }
  },
  "type": "object"
}