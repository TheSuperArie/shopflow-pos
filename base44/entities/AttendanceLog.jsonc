{
  "name": "AttendanceLog",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "מזהה עובד"
    },
    "employee_name": {
      "type": "string",
      "description": "שם העובד"
    },
    "clock_in": {
      "type": "string",
      "description": "זמן כניסה ISO"
    },
    "clock_out": {
      "type": "string",
      "description": "זמן יציאה ISO"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "תאריך המשמרת"
    },
    "opening_cash": {
      "type": "number",
      "description": "קופה פתיחה שדווח ע\"י העובד"
    },
    "closing_cash": {
      "type": "number",
      "description": "קופה סגירה שדווח ע\"י העובד"
    },
    "notes": {
      "type": "string"
    },
    "manually_edited": {
      "type": "boolean",
      "default": false,
      "description": "האם המשמרת נוספה או נערכה ידנית על ידי מנהל הסניף"
    },
    "branch_id": {
      "type": "string",
      "description": "מזהה הסניף בו נרשמה הנוכחות (FK to Branch). null = חנות יחידה / רשומה היסטורית — תואמות לאחור מלאה"
    },
    "station_email": {
      "type": "string",
      "description": "אימייל חשבון העמדה של הסניף שהרשומה שייכת לו (בחנות יחידה — החשבון שיצר את הרשומה). שדה בעלות להרשאות"
    },
    "tenant_email": {
      "type": "string",
      "description": "אימייל בעל הרשת שהסניף שייך לו. ריק = חנות יחידה שלא שייכת לרשת. שדה בעלות להרשאות"
    }
  },
  "required": [
    "employee_id",
    "employee_name",
    "clock_in",
    "date"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    }
  }
}