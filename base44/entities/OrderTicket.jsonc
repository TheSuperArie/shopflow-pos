{
  "name": "OrderTicket",
  "type": "object",
  "properties": {
    "tenant_email": {
      "type": "string",
      "description": "אימייל הטנאנט"
    },
    "branch_id": {
      "type": "string",
      "description": "מזהה הסניף"
    },
    "branch_name": {
      "type": "string",
      "description": "שם הסניף (denormalized)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "partial"
      ],
      "default": "pending",
      "description": "סטטוס כולל של ההזמנה"
    },
    "notes": {
      "type": "string",
      "description": "הערות כלליות להזמנה"
    },
    "total_items": {
      "type": "number",
      "description": "מספר פריטים בהזמנה"
    },
    "station_email": {
      "type": "string",
      "description": "אימייל חשבון העמדה של הסניף — שדה בעלות להרשאות"
    }
  },
  "required": [
    "tenant_email",
    "branch_id",
    "status"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    }
  }
}