{
  "name": "ProductGroup",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "שם התיקייה (למשל: חולצה לבנה קלאסית)"
    },
    "category_id": {
      "type": "string",
      "description": "קטגוריה"
    },
    "image_url": {
      "type": "string"
    },
    "has_uniform_price": {
      "type": "boolean",
      "default": true,
      "description": "האם כל הוריאציות באותו מחיר"
    },
    "uniform_sell_price": {
      "type": "number",
      "description": "מחיר מכירה אחיד (אם has_uniform_price=true)"
    },
    "uniform_cost_price": {
      "type": "number",
      "description": "מחיר עלות אחיד (אם has_uniform_price=true)"
    },
    "enabled_dimensions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "רשימת מזהי ממדים מופעלים למוצר זה",
      "default": []
    },
    "primary_dimension_id": {
      "type": "string",
      "description": "מזהה הממד הראשי לארגון היררכי של וריאציות (למשל: Size)"
    },
    "barcode": {
      "type": "string",
      "description": "ברקוד כללי למוצר (אופציונלי)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "האם המוצר פעיל ומוצג בקופה. false = מושבת ולא מוצג"
    },
    "branch_id": {
      "type": "string",
      "description": "מזהה הסניף שהמוצר נוצר עבורו על ידי מנהל הרשת — הקופה של הסניף טוענת גם מוצרים אלה. null = מוצר של החשבון עצמו"
    },
    "source_id": {
      "type": "string",
      "description": "מזהה הרשומה המקורית שממנה הועתק מוצר זה בשיתוף קטלוג — null = מקורי"
    },
    "station_email": {
      "type": "string",
      "description": "אימייל חשבון העמדה של הסניף — שדה בעלות להרשאות"
    },
    "tenant_email": {
      "type": "string",
      "description": "אימייל בעל הרשת. ריק = חנות יחידה — שדה בעלות להרשאות"
    },
    "low_stock_threshold": {
      "type": "number",
      "description": "סף חוסר למוצר הזה (לכל מידה). ריק = סף החוסר הכללי מההגדרות"
    }
  },
  "required": [
    "name",
    "category_id"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    }
  }
}