{
  "name": "Branch",
  "type": "object",
  "properties": {
    "tenant_email": {
      "type": "string",
      "description": "האימייל של בעל החנות (הטנאנט) שאליו שייך הסניף"
    },
    "name": {
      "type": "string",
      "description": "שם הסניף"
    },
    "station_email": {
      "type": "string",
      "description": "האימייל של חשבון Google שמופעל במכשיר הקופה הפיזית בסניף"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "האם הסניף פעיל"
    },
    "address": {
      "type": "string",
      "description": "כתובת פיזית של הסניף"
    },
    "manager_name": {
      "type": "string",
      "description": "שם מנהל הסניף"
    },
    "manager_phone": {
      "type": "string",
      "description": "טלפון מנהל הסניף"
    },
    "notes": {
      "type": "string",
      "description": "הערות פנימיות על הסניף"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "ACTIVE",
        "REJECTED"
      ],
      "default": "ACTIVE",
      "description": "סטטוס ההזמנה: PENDING=ממתין לאישור, ACTIVE=פעיל ומאושר, REJECTED=נדחה"
    },
    "system_approval": {
      "type": "string",
      "enum": [
        "PENDING_SYSTEM",
        "APPROVED",
        "REJECTED"
      ],
      "description": "אישור המערכת (המפתח) להצעת ההצטרפות. PENDING_SYSTEM = ההצעה עדיין לא הוצגה לבעל הסניף. ריק = רשומה היסטורית — מאושרת אוטומטית"
    },
    "receipt_prefix": {
      "type": "number",
      "description": "מספר הסניף במספור הקבלות: 1 → 1001000, 2 → 2001000 ... נקבע פעם אחת לפי סדר הצטרפות הסניפים לרשת"
    },
    "network_name": {
      "type": "string",
      "description": "שם הרשת שהזמינה את הסניף — מוצג בהודעת ההזמנה"
    },
    "business_model": {
      "type": "string",
      "enum": [
        "OWN_STOCK",
        "IMPORTER"
      ],
      "default": "IMPORTER",
      "description": "מודל עסקי: OWN_STOCK = המלאי שלנו, IMPORTER = מכירה עבור המייבא. ריק = מכירה עבור המייבא"
    },
    "catalog_share": {
      "type": "object",
      "description": "הגדרות שיתוף קטלוג לסניף זה — מה סומן להעברה בשיתוף האחרון מבעל הרשת",
      "properties": {
        "category_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "מזהי הקטגוריות ותתי הקטגוריות שאושרו להעברה"
        },
        "group_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "מזהי קבוצות המוצרים שאושרו להעברה"
        },
        "pv_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "מזהי הווריאציות (ProductVariant) שאושרו להעברה"
        },
        "fv_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "מזהי הווריאציות הגמישות (FlexibleVariant) שאושרו להעברה"
        },
        "dimension_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "מזהי הגדרות הממדים לתצוגה — רק אם אושרה העברת ברירות מחדל"
        },
        "include_sku": {
          "type": "boolean",
          "description": "האם להעביר את המקטים"
        },
        "include_cost": {
          "type": "boolean",
          "description": "האם להעביר את מחיר העלות"
        },
        "include_price": {
          "type": "boolean",
          "description": "האם להעביר את מחיר המכירה — אם לא, הסניף יקבע מחיר בעצמו"
        },
        "include_defaults": {
          "type": "boolean",
          "description": "האם להעביר ברירות מחדל כמו תצוגת וריאציות"
        },
        "shared_at": {
          "type": "string",
          "description": "מועד השיתוף האחרון"
        },
        "pulled_at": {
          "type": "string",
          "description": "מועד קליטת הקטלוג אצל הסניף — null = ממתין לקליטה"
        }
      }
    }
  },
  "required": [
    "tenant_email",
    "name",
    "station_email"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    }
  }
}