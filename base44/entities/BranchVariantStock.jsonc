{
  "name": "BranchVariantStock",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string",
      "description": "מזהה הסניף (FK to Branch)"
    },
    "variant_id": {
      "type": "string",
      "description": "מזהה הוריאנט (FK to FlexibleVariant). המלאי הגלובלי נשאר ב-FlexibleVariant.stock"
    },
    "stock": {
      "type": "number",
      "default": 0,
      "description": "כמות מלאי של וריאנט זה בסניף הספציפי"
    },
    "tenant_email": {
      "type": "string",
      "description": "האימייל של הטנאנט — לסינון נתונים בצד הקליינט ללא JOIN"
    },
    "station_email": {
      "type": "string",
      "description": "אימייל חשבון העמדה של הסניף — שדה בעלות להרשאות"
    }
  },
  "required": [
    "branch_id",
    "variant_id",
    "stock",
    "tenant_email"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    }
  }
}