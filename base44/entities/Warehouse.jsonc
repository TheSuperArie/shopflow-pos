{
  "name": "Warehouse",
  "type": "object",
  "properties": {
    "tenant_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d1\u05e2\u05dc \u05d4\u05e8\u05e9\u05ea \u05e9\u05d4\u05de\u05d7\u05e1\u05df \u05de\u05d7\u05d5\u05d1\u05e8 \u05d0\u05dc\u05d9\u05d4"
    },
    "network_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e8\u05e9\u05ea \u2014 \u05de\u05d5\u05e6\u05d2 \u05d1\u05d4\u05d6\u05de\u05e0\u05d4 \u05e9\u05d4\u05de\u05d7\u05e1\u05df \u05de\u05e7\u05d1\u05dc"
    },
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d7\u05e1\u05df"
    },
    "station_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d4\u05d7\u05e9\u05d1\u05d5\u05df \u05e9\u05d4\u05de\u05d7\u05e1\u05df \u05e2\u05d5\u05d1\u05d3 \u05de\u05de\u05e0\u05d5"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "ACTIVE",
        "REJECTED"
      ],
      "default": "PENDING",
      "description": "PENDING = \u05de\u05de\u05ea\u05d9\u05df \u05dc\u05d0\u05d9\u05e9\u05d5\u05e8 \u05d7\u05e9\u05d1\u05d5\u05df \u05d4\u05de\u05d7\u05e1\u05df, ACTIVE = \u05de\u05d7\u05d5\u05d1\u05e8, REJECTED = \u05e0\u05d3\u05d7\u05d4"
    },
    "is_active": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05de\u05d7\u05e1\u05df \u05e4\u05e2\u05d9\u05dc"
    },
    "address": {
      "type": "string",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea \u05d4\u05de\u05d7\u05e1\u05df"
    },
    "manager_name": {
      "type": "string",
      "description": "\u05d0\u05d9\u05e9 \u05e7\u05e9\u05e8 \u05d1\u05de\u05d7\u05e1\u05df"
    },
    "manager_phone": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df \u05d0\u05d9\u05e9 \u05d4\u05e7\u05e9\u05e8"
    },
    "network_phone": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df \u05d4\u05e0\u05d4\u05dc\u05ea \u05d4\u05e8\u05e9\u05ea \u2014 \u05de\u05d5\u05e6\u05d2 \u05dc\u05de\u05d7\u05e1\u05df \u05d1\u05ea\u05d7\u05ea\u05d9\u05ea \u05db\u05dc \u05d4\u05d6\u05de\u05e0\u05d4"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05e4\u05e0\u05d9\u05de\u05d9\u05d5\u05ea"
    },
    "admin_code": {
      "type": "string",
      "description": "\u05e7\u05d5\u05d3 \u05db\u05e0\u05d9\u05e1\u05d4 \u05dc\u05d3\u05e3 \u05d4\u05e0\u05d9\u05d4\u05d5\u05dc \u05e9\u05dc \u05d4\u05de\u05d7\u05e1\u05df (\u05d1\u05e8\u05d9\u05e8\u05ea \u05de\u05d7\u05d3\u05dc 1234) \u2014 \u05e0\u05e7\u05d1\u05e2 \u05e8\u05e7 \u05de\u05ea\u05d5\u05da \u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05d4\u05de\u05d7\u05e1\u05df"
    },
    "shortage_threshold": {
      "type": "number",
      "default": 0,
      "description": "\u05d9\u05d9\u05e6\u05d5\u05d0 \u05d7\u05d5\u05e1\u05e8\u05d9\u05dd \u05dc\u05d0\u05e7\u05e1\u05dc: \u05de\u05d9\u05d3\u05d4 \u05e0\u05db\u05e0\u05e1\u05ea \u05dc\u05e7\u05d5\u05d1\u05e5 \u05db\u05e9\u05d4\u05de\u05dc\u05d0\u05d9 \u05e9\u05dc\u05d4 \u05e2\u05d3 \u05d4\u05de\u05e1\u05e4\u05e8 \u05d4\u05d6\u05d4 (0 = \u05e8\u05e7 \u05de\u05d4 \u05e9\u05d0\u05d6\u05dc)"
    }
  },
  "required": [
    "tenant_email",
    "name",
    "station_email"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    }
  }
}