{
  "name": "SupplierPayment",
  "type": "object",
  "properties": {
    "supplier_id": {
      "type": "string",
      "description": "מזהה ספק"
    },
    "order_id": {
      "type": "string",
      "description": "מזהה הזמנה (אופציונלי)"
    },
    "amount": {
      "type": "number",
      "description": "סכום תשלום"
    },
    "payment_date": {
      "type": "string",
      "format": "date",
      "description": "תאריך תשלום"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "מזומן",
        "אשראי",
        "העברה בנקאית",
        "צ'ק"
      ],
      "description": "אמצעי תשלום"
    },
    "reference_number": {
      "type": "string",
      "description": "מספר אסמכתא"
    },
    "notes": {
      "type": "string",
      "description": "הערות"
    },
    "branch_id": {
      "type": "string",
      "description": "מזהה הסניף (FK to Branch)"
    },
    "station_email": {
      "type": "string",
      "description": "אימייל חשבון העמדה של הסניף — שדה בעלות להרשאות"
    },
    "tenant_email": {
      "type": "string",
      "description": "אימייל בעל הרשת. ריק = חנות יחידה — שדה בעלות להרשאות"
    }
  },
  "required": [
    "supplier_id",
    "amount",
    "payment_date",
    "payment_method"
  ]
}