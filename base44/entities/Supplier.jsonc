{
  "name": "Supplier",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "שם הספק"
    },
    "contact_person": {
      "type": "string",
      "description": "איש קשר"
    },
    "phone": {
      "type": "string",
      "description": "טלפון"
    },
    "email": {
      "type": "string",
      "description": "אימייל"
    },
    "address": {
      "type": "string",
      "description": "כתובת"
    },
    "notes": {
      "type": "string",
      "description": "הערות"
    },
    "total_debt": {
      "type": "number",
      "default": 0,
      "description": "סך חוב נוכחי"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "ספק פעיל"
    },
    "branch_id": {
      "type": "string",
      "description": "מזהה הסניף (FK to Branch)"
    },
    "station_email": {
      "type": "string",
      "description": "אימייל חשבון העמדה של הסניף — שדה בעלות להרשאות"
    },
    "tenant_email": {
      "type": "string",
      "description": "אימייל בעל הרשת. ריק = חנות יחידה — שדה בעלות להרשאות"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "id": "{{user.id}}"
      }
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    }
  }
}