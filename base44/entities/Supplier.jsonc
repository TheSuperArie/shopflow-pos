{
  "name": "Supplier",
  "properties": {
    "address": {
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea",
      "type": "string"
    },
    "branch_id": {
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e1\u05e0\u05d9\u05e3 (FK to Branch)",
      "type": "string"
    },
    "contact_person": {
      "description": "\u05d0\u05d9\u05e9 \u05e7\u05e9\u05e8",
      "type": "string"
    },
    "email": {
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc",
      "type": "string"
    },
    "is_active": {
      "default": true,
      "description": "\u05e1\u05e4\u05e7 \u05e4\u05e2\u05d9\u05dc",
      "type": "boolean"
    },
    "name": {
      "description": "\u05e9\u05dd \u05d4\u05e1\u05e4\u05e7",
      "type": "string"
    },
    "notes": {
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea",
      "type": "string"
    },
    "phone": {
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df",
      "type": "string"
    },
    "station_email": {
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d7\u05e9\u05d1\u05d5\u05df \u05d4\u05e2\u05de\u05d3\u05d4 \u05e9\u05dc \u05d4\u05e1\u05e0\u05d9\u05e3 \u2014 \u05e9\u05d3\u05d4 \u05d1\u05e2\u05dc\u05d5\u05ea \u05dc\u05d4\u05e8\u05e9\u05d0\u05d5\u05ea",
      "type": "string"
    },
    "tenant_email": {
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d1\u05e2\u05dc \u05d4\u05e8\u05e9\u05ea. \u05e8\u05d9\u05e7 = \u05d7\u05e0\u05d5\u05ea \u05d9\u05d7\u05d9\u05d3\u05d4 \u2014 \u05e9\u05d3\u05d4 \u05d1\u05e2\u05dc\u05d5\u05ea \u05dc\u05d4\u05e8\u05e9\u05d0\u05d5\u05ea",
      "type": "string"
    },
    "total_debt": {
      "default": 0,
      "description": "\u05e1\u05da \u05d7\u05d5\u05d1 \u05e0\u05d5\u05db\u05d7\u05d9",
      "type": "number"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": true,
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    }
  },
  "type": "object"
}