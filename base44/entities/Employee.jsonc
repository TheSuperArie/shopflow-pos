{
  "name": "Employee",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e2\u05d5\u05d1\u05d3"
    },
    "pin": {
      "type": "string",
      "description": "\u05e7\u05d5\u05d3 PIN \u05d1\u05df 4 \u05e1\u05e4\u05e8\u05d5\u05ea"
    },
    "phone": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df"
    },
    "role": {
      "type": "string",
      "enum": [
        "\u05e7\u05d5\u05e4\u05d0\u05d9",
        "\u05de\u05e0\u05d4\u05dc",
        "\u05e2\u05d5\u05d1\u05d3"
      ],
      "default": "\u05e7\u05d5\u05e4\u05d0\u05d9"
    },
    "hourly_rate": {
      "type": "number",
      "description": "\u05e9\u05db\u05e8 \u05dc\u05e9\u05e2\u05d4 (\u20aa) \u2014 \u05dc\u05d7\u05d9\u05e9\u05d5\u05d1 \u05d4\u05e9\u05db\u05e8 \u05d4\u05de\u05d2\u05d9\u05e2 \u05dc\u05e2\u05d5\u05d1\u05d3 \u05dc\u05e4\u05d9 \u05e9\u05e2\u05d5\u05ea \u05d4\u05e0\u05d5\u05db\u05d7\u05d5\u05ea"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "branch_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e1\u05e0\u05d9\u05e3 \u05d1\u05d5 \u05de\u05e9\u05d5\u05d9\u05da \u05d4\u05e2\u05d5\u05d1\u05d3 (FK to Branch). null = \u05d7\u05e0\u05d5\u05ea \u05d9\u05d7\u05d9\u05d3\u05d4 / \u05e8\u05e9\u05d5\u05de\u05d4 \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05ea \u2014 \u05ea\u05d5\u05d0\u05de\u05d5\u05ea \u05dc\u05d0\u05d7\u05d5\u05e8 \u05de\u05dc\u05d0\u05d4"
    }
  },
  "required": [
    "name",
    "pin"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "access_status": "approved"
      }
    },
    "create": {
      "user_condition": {
        "access_status": "approved"
      }
    },
    "update": {
      "user_condition": {
        "access_status": "approved"
      }
    },
    "delete": {
      "user_condition": {
        "access_status": "approved"
      }
    }
  }
}