{
  "name": "Employee",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "שם העובד"
    },
    "pin": {
      "type": "string",
      "description": "קוד PIN בן 4 ספרות"
    },
    "phone": {
      "type": "string",
      "description": "טלפון"
    },
    "role": {
      "type": "string",
      "enum": [
        "קופאי",
        "מנהל",
        "עובד"
      ],
      "default": "קופאי"
    },
    "hourly_rate": {
      "type": "number",
      "description": "שכר לשעה (₪) — לחישוב השכר המגיע לעובד לפי שעות הנוכחות"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "branch_id": {
      "type": "string",
      "description": "מזהה הסניף בו משויך העובד (FK to Branch). null = חנות יחידה / רשומה היסטורית — תואמות לאחור מלאה"
    },
    "station_email": {
      "type": "string",
      "description": "אימייל חשבון העמדה של הסניף שהרשומה שייכת לו (בחנות יחידה — החשבון שיצר את הרשומה). שדה בעלות להרשאות"
    },
    "tenant_email": {
      "type": "string",
      "description": "אימייל בעל הרשת שהסניף שייך לו. ריק = חנות יחידה שלא שייכת לרשת. שדה בעלות להרשאות"
    }
  },
  "required": [
    "name",
    "pin"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    }
  }
}