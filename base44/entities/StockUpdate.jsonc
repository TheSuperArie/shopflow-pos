{
  "name": "StockUpdate",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "quantity_added": {
      "type": "number"
    },
    "supplier_id": {
      "type": "string",
      "description": "מזהה ספק"
    },
    "supplier_name": {
      "type": "string"
    },
    "order_id": {
      "type": "string",
      "description": "מזהה הזמנה מספק"
    },
    "arrival_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "branch_id": {
      "type": "string",
      "description": "מזהה הסניף (FK to Branch)"
    },
    "station_email": {
      "type": "string",
      "description": "אימייל חשבון העמדה של הסניף — שדה בעלות להרשאות"
    },
    "tenant_email": {
      "type": "string",
      "description": "אימייל בעל הרשת. ריק = חנות יחידה — שדה בעלות להרשאות"
    }
  },
  "required": [
    "product_id",
    "quantity_added",
    "arrival_date"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    }
  }
}