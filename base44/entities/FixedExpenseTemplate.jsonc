{
  "name": "FixedExpenseTemplate",
  "properties": {
    "branch_id": {
      "description": "\u05d4\u05e1\u05e0\u05d9\u05e3 \u05e9\u05d0\u05dc\u05d9\u05d5 \u05e9\u05d9\u05d9\u05db\u05ea \u05d4\u05ea\u05d1\u05e0\u05d9\u05ea. null = \u05d7\u05e0\u05d5\u05ea \u05d9\u05d7\u05d9\u05d3\u05d4 / \u05ea\u05d1\u05e0\u05d9\u05ea \u05d1\u05e8\u05de\u05ea \u05e8\u05e9\u05ea",
      "type": "string"
    },
    "category": {
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d9\u05ea \u05d4\u05d4\u05d5\u05e6\u05d0\u05d4 \u05e9\u05ea\u05de\u05d5\u05dc\u05d0 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea",
      "type": "string"
    },
    "custom_category": {
      "description": "\u05e9\u05dd \u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05de\u05d5\u05ea\u05d0\u05de\u05ea (\u05e8\u05e7 \u05db\u05e9\u05d4\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05d4\u05d9\u05d0 '\u05d0\u05d7\u05e8')",
      "type": "string"
    },
    "default_amount": {
      "description": "\u05e1\u05db\u05d5\u05dd \u05d1\u05e8\u05d9\u05e8\u05ea \u05de\u05d7\u05d3\u05dc \u2014 \u05e0\u05d9\u05ea\u05df \u05dc\u05e2\u05e8\u05d9\u05db\u05d4 \u05d1\u05db\u05dc \u05e8\u05d9\u05e9\u05d5\u05dd",
      "type": "number"
    },
    "description": {
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9 \u2014 \u05d0\u05dd \u05e8\u05d9\u05e7, \u05e9\u05dd \u05d4\u05ea\u05d1\u05e0\u05d9\u05ea \u05de\u05e9\u05de\u05e9 \u05db\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05d4\u05d5\u05e6\u05d0\u05d4",
      "type": "string"
    },
    "is_active": {
      "default": true,
      "description": "\u05ea\u05d1\u05e0\u05d9\u05ea \u05de\u05d5\u05e9\u05d1\u05ea\u05ea \u05dc\u05d0 \u05de\u05d5\u05e6\u05d2\u05ea \u05d1\u05d1\u05d7\u05d9\u05e8\u05d4 \u05d1\u05d8\u05d5\u05e4\u05e1 \u05d4\u05d4\u05d5\u05e6\u05d0\u05d4",
      "type": "boolean"
    },
    "name": {
      "description": "\u05e9\u05dd \u05d4\u05ea\u05d1\u05e0\u05d9\u05ea (\u05dc\u05de\u05e9\u05dc: \u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05d8)",
      "type": "string"
    },
    "network_level": {
      "default": false,
      "description": "\u05ea\u05d1\u05e0\u05d9\u05ea \u05e9\u05dc \u05d4\u05d5\u05e6\u05d0\u05d5\u05ea \u05d4\u05e8\u05e9\u05ea \u05e2\u05e6\u05de\u05d4 (\u05dc\u05d0 \u05e9\u05dc \u05e1\u05e0\u05d9\u05e3)",
      "type": "boolean"
    },
    "network_only": {
      "default": false,
      "description": "\u05ea\u05d1\u05e0\u05d9\u05ea \u05e9\u05de\u05e0\u05d4\u05dc \u05d4\u05e8\u05e9\u05ea \u05e9\u05de\u05e8 \u05dc\u05e1\u05e0\u05d9\u05e3 \u05de\u05e1\u05d5\u05d9\u05dd (\u05de\u05d3\u05e3 \u05d4\u05e1\u05e0\u05d9\u05e3 \u05d1\u05d3\u05e9\u05d1\u05d5\u05e8\u05d3 \u05d4\u05e8\u05e9\u05ea) \u2014 \u05de\u05d5\u05e6\u05d2\u05ea \u05e8\u05e7 \u05d1\u05e6\u05d3 \u05d4\u05e8\u05e9\u05ea, \u05de\u05e0\u05d4\u05dc \u05d4\u05e1\u05e0\u05d9\u05e3 \u05dc\u05d0 \u05e8\u05d5\u05d0\u05d4 \u05d0\u05d5\u05ea\u05d4",
      "type": "boolean"
    },
    "station_email": {
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d7\u05e9\u05d1\u05d5\u05df \u05d4\u05e2\u05de\u05d3\u05d4 \u05e9\u05dc \u05d4\u05e1\u05e0\u05d9\u05e3 \u2014 \u05e9\u05d3\u05d4 \u05d1\u05e2\u05dc\u05d5\u05ea \u05dc\u05d4\u05e8\u05e9\u05d0\u05d5\u05ea",
      "type": "string"
    },
    "tenant_email": {
      "description": "\u05d4\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05e9\u05dc \u05d1\u05e2\u05dc \u05d4\u05e8\u05e9\u05ea \u2014 \u05de\u05e9\u05de\u05e9 \u05d2\u05dd \u05db\u05e9\u05d3\u05d4 \u05d1\u05e2\u05dc\u05d5\u05ea \u05dc\u05d4\u05e8\u05e9\u05d0\u05d5\u05ea",
      "type": "string"
    }
  },
  "required": [
    "name",
    "default_amount",
    "category"
  ],
  "rls": {
    "create": true,
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    }
  },
  "type": "object"
}