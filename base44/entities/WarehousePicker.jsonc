{
  "name": "WarehousePicker",
  "type": "object",
  "properties": {
    "warehouse_id": {
      "type": "string",
      "description": "המחסן (FK to Warehouse)"
    },
    "tenant_email": {
      "type": "string",
      "description": "אימייל בעל הרשת"
    },
    "name": {
      "type": "string",
      "description": "שם המלקט"
    },
    "phone": {
      "type": "string",
      "description": "טלפון (אופציונלי)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "מלקט פעיל — רק פעילים מופיעים בבחירת מלקט"
    },
    "hourly_rate": {
      "type": "number",
      "description": "שכר לשעה (₪) — לחישוב השכר המגיע למלקט, כמו בעובדי הסניפים"
    },
    "pin": {
      "type": "string",
      "description": "קוד אישי בן 4 ספרות לכניסה לפורטל המלקטים — ייחודי בתוך המחסן"
    }
  },
  "required": [
    "warehouse_id",
    "name"
  ]
}