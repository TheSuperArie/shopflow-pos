{
  "name": "StockRequest",
  "type": "object",
  "properties": {
    "tenant_email": {
      "type": "string",
      "description": "האימייל של בעל החנות — לסינון בצד הקליינט"
    },
    "branch_id": {
      "type": "string",
      "description": "הסניף שמבקש המלאי (FK to Branch)"
    },
    "ticket_id": {
      "type": "string",
      "description": "מזהה כרטיס ההזמנה (FK to OrderTicket)"
    },
    "variant_id": {
      "type": "string",
      "description": "הוריאנט המבוקש (FK to FlexibleVariant)"
    },
    "variant_label": {
      "type": "string",
      "description": "תיאור טקסטואלי של הוריאנט לתצוגה (שם + מידות)"
    },
    "requested_qty": {
      "type": "number",
      "description": "כמות מבוקשת"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "סטטוס הבקשה"
    },
    "approved_qty": {
      "type": "number",
      "description": "כמות שאושרה בפועל (יכולה להיות שונה מהמבוקשת)"
    },
    "notes": {
      "type": "string",
      "description": "הערות"
    },
    "station_email": {
      "type": "string",
      "description": "אימייל חשבון העמדה של הסניף — שדה בעלות להרשאות"
    }
  },
  "required": [
    "tenant_email",
    "branch_id",
    "variant_id",
    "requested_qty",
    "status"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    }
  }
}