{
  "name": "AccessRequest",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05dc\u05d0 \u05e9\u05dc \u05de\u05d1\u05e7\u05e9 \u05d4\u05d2\u05d9\u05e9\u05d4"
    },
    "phone": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df \u05dc\u05d9\u05e6\u05d9\u05e8\u05ea \u05e7\u05e9\u05e8"
    },
    "email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05dc\u05d9\u05e6\u05d9\u05e8\u05ea \u05e7\u05e9\u05e8"
    },
    "account_email": {
      "type": "string",
      "description": "\u05d4\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05e9\u05dc \u05d4\u05d7\u05e9\u05d1\u05d5\u05df \u05d4\u05de\u05d7\u05d5\u05d1\u05e8 \u05e9\u05de\u05de\u05e0\u05d5 \u05e0\u05e9\u05dc\u05d7\u05d4 \u05d4\u05d1\u05e7\u05e9\u05d4 \u2014 \u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "blocked"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d1\u05e7\u05e9\u05d4 \u2014 \u05dc\u05ea\u05e6\u05d5\u05d2\u05d4 \u05d1\u05dc\u05d1\u05d3, \u05d4\u05d2\u05d9\u05e9\u05d4 \u05dc\u05d0\u05ea\u05e8 \u05e0\u05e7\u05d1\u05e2\u05ea \u05dc\u05e4\u05d9 User.access_status"
    },
    "decided_at": {
      "type": "string",
      "description": "\u05de\u05d5\u05e2\u05d3 \u05d4\u05d4\u05d7\u05dc\u05d8\u05d4 (ISO)"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05de\u05e4\u05ea\u05d7"
    }
  },
  "required": [
    "full_name",
    "phone",
    "email"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "__developer_service_role_only__"
    },
    "update": {
      "created_by_id": "__developer_service_role_only__"
    },
    "delete": {
      "created_by_id": "__developer_service_role_only__"
    }
  }
}