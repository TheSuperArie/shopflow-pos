{
  "name": "Sale",
  "properties": {
    "branch_id": {
      "description": "מזהה הסניף בו בוצעה המכירה (FK to Branch). null = חנות יחידה / גלובלי — תואמות לאחור מלאה",
      "type": "string"
    },
    "cash_amount": {
      "description": "החלק ששולם במזומן בתשלום מפוצל",
      "type": "number"
    },
    "cash_change": {
      "description": "עודף שהוחזר",
      "type": "number"
    },
    "cash_received": {
      "description": "סכום שהתקבל במזומן",
      "type": "number"
    },
    "client_sale_id": {
      "description": "מזהה ייחודי שהקופה יוצרת לכל מכירה — מונע כפילות כשמנסים שוב אחרי שגיאה",
      "type": "string"
    },
    "credit_amount": {
      "description": "החלק ששולם באשראי בתשלום מפוצל",
      "type": "number"
    },
    "credit_provider": {
      "type": "string",
      "description": "איפה חויב האשראי: 'nedarim' = דרך חלון נדרים פלוס בקופה; ריק = ידני (מסוף/טאבלט נפרד)"
    },
    "credit_ref": {
      "type": "string",
      "description": "מספר העסקה / האישור שהחזיר ספק הסליקה"
    },
    "credit_details": {
      "type": "object",
      "description": "התשובה המלאה של ספק הסליקה (לבירורים) — בלי פרטי כרטיס"
    },
    "items": {
      "items": {
        "properties": {
          "cost_price": {
            "type": "number"
          },
          "group_id": {
            "description": "FK to ProductGroup",
            "type": "string"
          },
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "sell_price": {
            "type": "number"
          },
          "variant_id": {
            "description": "FK to ProductVariant",
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "payment_method": {
      "enum": [
        "מזומן",
        "אשראי",
        "מזומן + אשראי"
      ],
      "type": "string"
    },
    "seller_email": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "station_email": {
      "description": "אימייל חשבון העמדה של הסניף — שדה בעלות להרשאות",
      "type": "string"
    },
    "tenant_email": {
      "description": "אימייל בעל הרשת. ריק = חנות יחידה — שדה בעלות להרשאות",
      "type": "string"
    },
    "total": {
      "type": "number"
    },
    "total_cost": {
      "type": "number"
    }
  },
  "required": [
    "items",
    "total",
    "payment_method"
  ],
  "rls": {
    "create": true,
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    }
  },
  "type": "object"
}