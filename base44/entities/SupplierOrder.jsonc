{
  "name": "SupplierOrder",
  "type": "object",
  "properties": {
    "supplier_id": {
      "type": "string",
      "description": "מזהה ספק"
    },
    "order_number": {
      "type": "string",
      "description": "מספר הזמנה"
    },
    "order_date": {
      "type": "string",
      "format": "date",
      "description": "תאריך הזמנה"
    },
    "expected_delivery": {
      "type": "string",
      "format": "date",
      "description": "תאריך אספקה משוער"
    },
    "status": {
      "type": "string",
      "enum": [
        "ממתין",
        "בדרך",
        "התקבל חלקית",
        "התקבל",
        "בוטל"
      ],
      "default": "ממתין",
      "description": "סטטוס הזמנה"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "פריטי ההזמנה"
    },
    "total_amount": {
      "type": "number",
      "description": "סכום כולל"
    },
    "paid_amount": {
      "type": "number",
      "default": 0,
      "description": "סכום ששולם"
    },
    "notes": {
      "type": "string",
      "description": "הערות"
    },
    "branch_id": {
      "type": "string",
      "description": "מזהה הסניף (FK to Branch)"
    },
    "station_email": {
      "type": "string",
      "description": "אימייל חשבון העמדה של הסניף — שדה בעלות להרשאות"
    },
    "tenant_email": {
      "type": "string",
      "description": "אימייל בעל הרשת. ריק = חנות יחידה — שדה בעלות להרשאות"
    }
  },
  "required": [
    "supplier_id",
    "order_date",
    "total_amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "id": "{{user.id}}"
      }
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    }
  }
}