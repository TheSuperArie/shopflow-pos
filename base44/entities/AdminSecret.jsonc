{
  "name": "AdminSecret",
  "type": "object",
  "properties": {
    "owner_email": {
      "type": "string",
      "description": "אימייל החשבון שהקודים שייכים לו (באותיות קטנות)"
    },
    "admin_password": {
      "type": "string",
      "description": "קוד מנהל הסניף. ריק = קוד ברירת המחדל. נקרא ונבדק רק בשרת (adminAuth)"
    },
    "network_admin_password": {
      "type": "string",
      "description": "קוד מאסטר לבעל הרשת. ריק = קוד ברירת המחדל. נקרא ונבדק רק בשרת (adminAuth)"
    },
    "failed_count": {
      "type": "number",
      "default": 0,
      "description": "ניסיונות שגויים ברצף"
    },
    "blocked_until": {
      "type": "string",
      "description": "חסימה זמנית אחרי יותר מדי ניסיונות שגויים (ISO)"
    },
    "nedarim_enabled": {
      "type": "boolean",
      "default": false,
      "description": "סליקת אשראי דרך נדרים פלוס בקופה פעילה"
    },
    "nedarim_mosad": {
      "type": "string",
      "description": "מספר המוסד בנדרים פלוס"
    },
    "nedarim_api_valid": {
      "type": "string",
      "description": "קוד ApiValid לחלון התשלום (iframe) של נדרים פלוס — נקרא רק דרך השרת (adminAuth)"
    }
  },
  "rls": {
    "read": {
      "created_by_id": "__developer_service_role_only__"
    },
    "create": {
      "created_by_id": "__developer_service_role_only__"
    },
    "update": {
      "created_by_id": "__developer_service_role_only__"
    },
    "delete": {
      "created_by_id": "__developer_service_role_only__"
    }
  },
  "required": [
    "owner_email"
  ]
}