{
  "name": "AdminSecret",
  "type": "object",
  "properties": {
    "owner_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d4\u05d7\u05e9\u05d1\u05d5\u05df \u05e9\u05d4\u05e7\u05d5\u05d3\u05d9\u05dd \u05e9\u05d9\u05d9\u05db\u05d9\u05dd \u05dc\u05d5 (\u05d1\u05d0\u05d5\u05ea\u05d9\u05d5\u05ea \u05e7\u05d8\u05e0\u05d5\u05ea)"
    },
    "admin_password": {
      "type": "string",
      "description": "\u05e7\u05d5\u05d3 \u05de\u05e0\u05d4\u05dc \u05d4\u05e1\u05e0\u05d9\u05e3. \u05e8\u05d9\u05e7 = \u05e7\u05d5\u05d3 \u05d1\u05e8\u05d9\u05e8\u05ea \u05d4\u05de\u05d7\u05d3\u05dc. \u05e0\u05e7\u05e8\u05d0 \u05d5\u05e0\u05d1\u05d3\u05e7 \u05e8\u05e7 \u05d1\u05e9\u05e8\u05ea (adminAuth)"
    },
    "network_admin_password": {
      "type": "string",
      "description": "\u05e7\u05d5\u05d3 \u05de\u05d0\u05e1\u05d8\u05e8 \u05dc\u05d1\u05e2\u05dc \u05d4\u05e8\u05e9\u05ea. \u05e8\u05d9\u05e7 = \u05e7\u05d5\u05d3 \u05d1\u05e8\u05d9\u05e8\u05ea \u05d4\u05de\u05d7\u05d3\u05dc. \u05e0\u05e7\u05e8\u05d0 \u05d5\u05e0\u05d1\u05d3\u05e7 \u05e8\u05e7 \u05d1\u05e9\u05e8\u05ea (adminAuth)"
    },
    "failed_count": {
      "type": "number",
      "default": 0,
      "description": "\u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05e9\u05d2\u05d5\u05d9\u05d9\u05dd \u05d1\u05e8\u05e6\u05e3"
    },
    "blocked_until": {
      "type": "string",
      "description": "\u05d7\u05e1\u05d9\u05de\u05d4 \u05d6\u05de\u05e0\u05d9\u05ea \u05d0\u05d7\u05e8\u05d9 \u05d9\u05d5\u05ea\u05e8 \u05de\u05d3\u05d9 \u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05e9\u05d2\u05d5\u05d9\u05d9\u05dd (ISO)"
    },
    "nedarim_enabled": {
      "type": "boolean",
      "default": false,
      "description": "\u05e1\u05dc\u05d9\u05e7\u05ea \u05d0\u05e9\u05e8\u05d0\u05d9 \u05d3\u05e8\u05da \u05e0\u05d3\u05e8\u05d9\u05dd \u05e4\u05dc\u05d5\u05e1 \u05d1\u05e7\u05d5\u05e4\u05d4 \u05e4\u05e2\u05d9\u05dc\u05d4"
    },
    "nedarim_mosad": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05de\u05d5\u05e1\u05d3 \u05d1\u05e0\u05d3\u05e8\u05d9\u05dd \u05e4\u05dc\u05d5\u05e1"
    },
    "nedarim_api_valid": {
      "type": "string",
      "description": "\u05e7\u05d5\u05d3 ApiValid \u05dc\u05d7\u05dc\u05d5\u05df \u05d4\u05ea\u05e9\u05dc\u05d5\u05dd (iframe) \u05e9\u05dc \u05e0\u05d3\u05e8\u05d9\u05dd \u05e4\u05dc\u05d5\u05e1 \u2014 \u05e0\u05e7\u05e8\u05d0 \u05e8\u05e7 \u05d3\u05e8\u05da \u05d4\u05e9\u05e8\u05ea (adminAuth)"
    },
    "delegate_of": {
      "type": "string",
      "description": "\u05de\u05e0\u05d4\u05dc \u05e8\u05e9\u05ea \u05de\u05d5\u05e8\u05e9\u05d4: \u05de\u05d9\u05d9\u05dc \u05d1\u05e2\u05dc \u05d4\u05e8\u05e9\u05ea (\u05d0\u05d5\u05ea\u05d9\u05d5\u05ea \u05e7\u05d8\u05e0\u05d5\u05ea) \u05e9\u05d4\u05d7\u05e9\u05d1\u05d5\u05df owner_email \u05de\u05e0\u05d4\u05dc \u05d1\u05e9\u05de\u05d5 \u2014 \u05e0\u05db\u05e0\u05e1 \u05e8\u05e7 \u05dc\u05d3\u05e9\u05d1\u05d5\u05e8\u05d3 \u05d4\u05e8\u05e9\u05ea, \u05db\u05dc \u05e4\u05e2\u05d5\u05dc\u05d5\u05ea\u05d9\u05d5 \u05d3\u05e8\u05da \u05d4\u05e9\u05e8\u05ea (networkDelegate). \u05e0\u05e7\u05d1\u05e2 \u05e8\u05e7 \u05d1\u05d9\u05d3\u05d9 \u05d4\u05de\u05e4\u05ea\u05d7"
    }
  },
  "rls": {
    "read": {
      "created_by_id": "__developer_service_role_only__"
    },
    "create": {
      "created_by_id": "__developer_service_role_only__"
    },
    "update": {
      "created_by_id": "__developer_service_role_only__"
    },
    "delete": {
      "created_by_id": "__developer_service_role_only__"
    }
  },
  "required": [
    "owner_email"
  ]
}