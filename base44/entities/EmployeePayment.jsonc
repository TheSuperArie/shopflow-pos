{
  "name": "EmployeePayment",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "מזהה עובד"
    },
    "employee_name": {
      "type": "string",
      "description": "שם עובד"
    },
    "amount": {
      "type": "number",
      "description": "סכום תשלום"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "מזומן",
        "העברה בנקאית",
        "צ'ק",
        "אחר"
      ],
      "default": "מזומן"
    },
    "payment_date": {
      "type": "string",
      "format": "date",
      "description": "תאריך תשלום"
    },
    "notes": {
      "type": "string",
      "description": "הערות"
    },
    "payment_type": {
      "type": "string",
      "enum": [
        "משכורת",
        "בונוס",
        "עמלה",
        "אחר"
      ],
      "default": "משכורת",
      "description": "סוג תשלום"
    },
    "branch_id": {
      "type": "string",
      "description": "מזהה הסניף שהתשלום שייך לו (FK to Branch). null = חנות יחידה / רשומה היסטורית"
    },
    "station_email": {
      "type": "string",
      "description": "אימייל חשבון העמדה של הסניף שהרשומה שייכת לו (בחנות יחידה — החשבון שיצר את הרשומה). שדה בעלות להרשאות"
    },
    "tenant_email": {
      "type": "string",
      "description": "אימייל בעל הרשת שהסניף שייך לו. ריק = חנות יחידה שלא שייכת לרשת. שדה בעלות להרשאות"
    }
  },
  "required": [
    "employee_id",
    "employee_name",
    "amount",
    "payment_date",
    "payment_method"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    }
  }
}