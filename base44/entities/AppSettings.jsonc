{
  "name": "AppSettings",
  "properties": {
    "admin_password": {
      "description": "\u05dc\u05d0 \u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u2014 \u05e7\u05d5\u05d3 \u05de\u05e0\u05d4\u05dc \u05d4\u05e1\u05e0\u05d9\u05e3 \u05e2\u05d1\u05e8 \u05dc\u05e9\u05e8\u05ea (AdminSecret / adminAuth). \u05e0\u05e9\u05d0\u05e8 \u05e8\u05e7 \u05e1\u05d9\u05de\u05d5\u05df.",
      "type": "string"
    },
    "branch_id": {
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e1\u05e0\u05d9\u05e3 (FK to Branch)",
      "type": "string"
    },
    "dashboard_default_dimension": {
      "description": "\u05e9\u05dd \u05d4\u05de\u05de\u05d3 \u05e9\u05d9\u05d5\u05e6\u05d2 \u05db\u05d1\u05e8\u05d9\u05e8\u05ea \u05de\u05d7\u05d3\u05dc \u05d1\u05e4\u05d9\u05dc\u05d5\u05d7 P3+ \u05d1\u05dc\u05d5\u05d7 \u05d4\u05d1\u05e7\u05e8\u05d4 (\u05dc\u05de\u05e9\u05dc: \u05d2\u05d5\u05d3\u05dc, \u05e6\u05d1\u05e2)",
      "type": "string"
    },
    "low_stock_threshold": {
      "default": 5,
      "description": "\u05e1\u05e3 \u05de\u05dc\u05d0\u05d9 \u05e0\u05de\u05d5\u05da - \u05de\u05ea\u05d7\u05ea\u05d9\u05d5 \u05de\u05d5\u05e6\u05d2 \u05d0\u05d6\u05d4\u05e8\u05d4",
      "type": "number"
    },
    "network_admin_password": {
      "description": "\u05dc\u05d0 \u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u2014 \u05e7\u05d5\u05d3 \u05d4\u05de\u05d0\u05e1\u05d8\u05e8 \u05e9\u05dc \u05d4\u05e8\u05e9\u05ea \u05e2\u05d1\u05e8 \u05dc\u05e9\u05e8\u05ea (AdminSecret / adminAuth). \u05e0\u05e9\u05d0\u05e8 \u05e8\u05e7 \u05e1\u05d9\u05de\u05d5\u05df.",
      "type": "string"
    },
    "network_name": {
      "description": "\u05e9\u05dd \u05d4\u05e8\u05e9\u05ea \u05d4\u05de\u05d5\u05e6\u05d2 \u05d1\u05e8\u05d0\u05e9 \u05db\u05dc \u05d3\u05e3 \u05d1\u05d3\u05e9\u05d1\u05d5\u05e8\u05d3 \u05de\u05e0\u05d4\u05dc \u05d4\u05e8\u05e9\u05ea",
      "type": "string"
    },
    "notifications_enabled": {
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05dc\u05d4\u05e6\u05d9\u05d2 \u05d4\u05ea\u05e8\u05d0\u05d5\u05ea \u05d5\u05dc\u05d4\u05e9\u05de\u05d9\u05e2 \u05e6\u05dc\u05d9\u05dc \u05db\u05e9\u05de\u05d2\u05d9\u05e2\u05d4 \u05d4\u05d5\u05d3\u05e2\u05d4 \u05de\u05d4\u05e8\u05e9\u05ea. \u05d1\u05e8\u05d9\u05e8\u05ea \u05de\u05d7\u05d3\u05dc: \u05e4\u05e2\u05d9\u05dc.",
      "type": "boolean"
    },
    "pos_virtual_folders": {
      "default": [],
      "description": "\u05ea\u05d9\u05e7\u05d9\u05d5\u05ea \u05d5\u05d9\u05e8\u05d8\u05d5\u05d0\u05dc\u05d9\u05d5\u05ea \u05d1\u05e7\u05d5\u05e4\u05d4 \u2014 \u05dc\u05e0\u05d5\u05d7\u05d5\u05ea \u05d4\u05e7\u05d5\u05e4\u05d0\u05d9\u05dd \u05d1\u05dc\u05d1\u05d3, \u05dc\u05dc\u05d0 \u05d4\u05e9\u05e4\u05e2\u05d4 \u05e2\u05dc \u05de\u05e1\u05d3 \u05d4\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd",
      "items": {
        "properties": {
          "category_id": {
            "description": "\u05d0\u05dd \u05de\u05d5\u05d2\u05d3\u05e8 \u2014 \u05d4\u05ea\u05e7\u05d9\u05d9\u05d4 \u05ea\u05d5\u05e4\u05d9\u05e2 \u05e8\u05e7 \u05d1\u05ea\u05ea-\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4/\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05d6\u05d5 \u05d1\u05e7\u05d5\u05e4\u05d4",
            "type": "string"
          },
          "group_ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "pos_watermark_url": {
      "description": "\u05dc\u05d5\u05d2\u05d5 \u05e9\u05e7\u05d5\u05e3 \u05d1\u05e8\u05e7\u05e2 \u05d4\u05e7\u05d5\u05e4\u05d4 (\u05db\u05ea\u05d5\u05d1\u05ea \u05ea\u05de\u05d5\u05e0\u05d4). \u05e8\u05d9\u05e7 = \u05d1\u05dc\u05d9 \u05dc\u05d5\u05d2\u05d5",
      "type": "string"
    },
    "station_email": {
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d7\u05e9\u05d1\u05d5\u05df \u05d4\u05e2\u05de\u05d3\u05d4 \u05e9\u05dc \u05d4\u05e1\u05e0\u05d9\u05e3 \u2014 \u05e9\u05d3\u05d4 \u05d1\u05e2\u05dc\u05d5\u05ea \u05dc\u05d4\u05e8\u05e9\u05d0\u05d5\u05ea",
      "type": "string"
    },
    "stock_mode_enabled": {
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05d7\u05e0\u05d5\u05ea \u05e4\u05d5\u05e2\u05dc\u05ea \u05e2\u05dc \u05e4\u05d9 \u05de\u05dc\u05d0\u05d9. \u05db\u05d1\u05d5\u05d9 \u2014 \u05e0\u05d9\u05ea\u05df \u05dc\u05de\u05db\u05d5\u05e8 \u05d1\u05e7\u05d5\u05e4\u05d4 \u05d2\u05dd \u05de\u05d5\u05e6\u05e8\u05d9\u05dd \u05e9\u05d0\u05d9\u05df \u05d1\u05de\u05dc\u05d0\u05d9, \u05d5\u05de\u05db\u05d9\u05e8\u05d5\u05ea \u05d0\u05d9\u05e0\u05df \u05de\u05d5\u05e8\u05d9\u05d3\u05d5\u05ea \u05e4\u05e8\u05d9\u05d8\u05d9\u05dd \u05de\u05d4\u05de\u05dc\u05d0\u05d9. \u05d3\u05e4\u05d9 \u05d4\u05d3\u05d5\u05d7\u05d5\u05ea \u05de\u05de\u05e9\u05d9\u05db\u05d9\u05dd \u05db\u05e8\u05d2\u05d9\u05dc.",
      "type": "boolean"
    },
    "store_name": {
      "default": "\u05d4\u05d7\u05e0\u05d5\u05ea \u05e9\u05dc\u05d9",
      "type": "string"
    },
    "tenant_email": {
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d1\u05e2\u05dc \u05d4\u05e8\u05e9\u05ea. \u05e8\u05d9\u05e7 = \u05d7\u05e0\u05d5\u05ea \u05d9\u05d7\u05d9\u05d3\u05d4 \u2014 \u05e9\u05d3\u05d4 \u05d1\u05e2\u05dc\u05d5\u05ea \u05dc\u05d4\u05e8\u05e9\u05d0\u05d5\u05ea",
      "type": "string"
    }
  },
  "required": [],
  "type": "object",
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    }
  }
}