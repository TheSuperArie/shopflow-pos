{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "admin_password": {
      "type": "string",
      "description": "לא בשימוש — קוד מנהל הסניף עבר לשרת (AdminSecret / adminAuth). נשאר רק סימון."
    },
    "network_admin_password": {
      "type": "string",
      "description": "לא בשימוש — קוד המאסטר של הרשת עבר לשרת (AdminSecret / adminAuth). נשאר רק סימון."
    },
    "store_name": {
      "type": "string",
      "default": "החנות שלי"
    },
    "network_name": {
      "type": "string",
      "description": "שם הרשת המוצג בראש כל דף בדשבורד מנהל הרשת"
    },
    "low_stock_threshold": {
      "type": "number",
      "default": 5,
      "description": "סף מלאי נמוך - מתחתיו מוצג אזהרה"
    },
    "dashboard_default_dimension": {
      "type": "string",
      "description": "שם הממד שיוצג כברירת מחדל בפילוח P3+ בלוח הבקרה (למשל: גודל, צבע)"
    },
    "notifications_enabled": {
      "type": "boolean",
      "default": true,
      "description": "האם להציג התראות ולהשמיע צליל כשמגיעה הודעה מהרשת. ברירת מחדל: פעיל."
    },
    "stock_mode_enabled": {
      "type": "boolean",
      "default": true,
      "description": "האם החנות פועלת על פי מלאי. כבוי — ניתן למכור בקופה גם מוצרים שאין במלאי, ומכירות אינן מורידות פריטים מהמלאי. דפי הדוחות ממשיכים כרגיל."
    },
    "pos_virtual_folders": {
      "type": "array",
      "description": "תיקיות וירטואליות בקופה — לנוחות הקופאים בלבד, ללא השפעה על מסד הנתונים",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category_id": {
            "type": "string",
            "description": "אם מוגדר — התקייה תופיע רק בתת-קטגוריה/קטגוריה זו בקופה"
          },
          "group_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "default": []
    },
    "branch_id": {
      "type": "string",
      "description": "מזהה הסניף (FK to Branch)"
    },
    "station_email": {
      "type": "string",
      "description": "אימייל חשבון העמדה של הסניף — שדה בעלות להרשאות"
    },
    "tenant_email": {
      "type": "string",
      "description": "אימייל בעל הרשת. ריק = חנות יחידה — שדה בעלות להרשאות"
    }
  },
  "required": [],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    }
  }
}