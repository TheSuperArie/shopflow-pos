{
  "name": "TicketChat",
  "type": "object",
  "properties": {
    "ticket_id": {
      "type": "string",
      "description": "מזהה כרטיס ההזמנה"
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "BRANCH",
        "HQ"
      ],
      "description": "מי שלח: BRANCH = הסניף, HQ = המטה"
    },
    "message_text": {
      "type": "string",
      "description": "תוכן ההודעה"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "האם נקרא על ידי הצד השני"
    }
  },
  "required": [
    "ticket_id",
    "sender_role",
    "message_text"
  ],
  "rls": {
    "create": {
      "created_by_id": "__developer_service_role_only__"
    },
    "read": {
      "created_by_id": "__developer_service_role_only__"
    },
    "update": {
      "created_by_id": "__developer_service_role_only__"
    },
    "delete": {
      "created_by_id": "__developer_service_role_only__"
    }
  }
}