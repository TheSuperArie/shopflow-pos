{
  "name": "NetworkAlert",
  "type": "object",
  "properties": {
    "tenant_email": {
      "type": "string",
      "description": "האימייל של בעל הרשת (Master Admin) שצריך לקבל את ההתראה"
    },
    "type": {
      "type": "string",
      "enum": [
        "INVITE_ACCEPTED",
        "ORDER_PENDING",
        "WAREHOUSE_PRODUCT_PENDING"
      ],
      "description": "סוג ההתראה"
    },
    "title": {
      "type": "string",
      "description": "כותרת קצרה"
    },
    "body": {
      "type": "string",
      "description": "תוכן ההתראה"
    },
    "branch_id": {
      "type": "string",
      "description": "מזהה הסניף הרלוונטי"
    },
    "branch_name": {
      "type": "string",
      "description": "שם הסניף הרלוונטי"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "האם נקראה"
    },
    "navigate_to": {
      "type": "string",
      "description": "הטאב שאליו ינווט כאשר לוחצים על ההתראה (e.g. branches, orders, warehouse-stock)"
    }
  },
  "required": [
    "tenant_email",
    "type",
    "title",
    "body"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    }
  }
}