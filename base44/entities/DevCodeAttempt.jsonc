{
  "name": "DevCodeAttempt",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "\u05d4\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05e9\u05dc \u05d4\u05d7\u05e9\u05d1\u05d5\u05df \u05e9\u05e0\u05d9\u05e1\u05d4 \u05dc\u05d4\u05d6\u05d9\u05df \u05e7\u05d5\u05d3 \u05de\u05e4\u05ea\u05d7"
    },
    "failed_count": {
      "type": "number",
      "default": 0,
      "description": "\u05de\u05e1\u05e4\u05e8 \u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05e9\u05d2\u05d5\u05d9\u05d9\u05dd \u05e8\u05e6\u05d5\u05e4\u05d9\u05dd"
    },
    "blocked_until": {
      "type": "string",
      "description": "\u05d7\u05e1\u05d9\u05de\u05d4 \u05e2\u05d3 \u05dc\u05de\u05d5\u05e2\u05d3 \u05d6\u05d4 (ISO). \u05e8\u05d9\u05e7 = \u05dc\u05d0 \u05d7\u05e1\u05d5\u05dd"
    },
    "last_attempt_at": {
      "type": "string",
      "description": "\u05de\u05d5\u05e2\u05d3 \u05d4\u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05d4\u05d0\u05d7\u05e8\u05d5\u05df (ISO)"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "read": {
      "created_by_id": "__developer_service_role_only__"
    },
    "create": {
      "created_by_id": "__developer_service_role_only__"
    },
    "update": {
      "created_by_id": "__developer_service_role_only__"
    },
    "delete": {
      "created_by_id": "__developer_service_role_only__"
    }
  }
}