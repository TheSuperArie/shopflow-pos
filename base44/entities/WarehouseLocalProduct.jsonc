{
  "name": "WarehouseLocalProduct",
  "type": "object",
  "properties": {
    "warehouse_id": {
      "type": "string",
      "description": "\u05d4\u05de\u05d7\u05e1\u05df (FK to Warehouse)"
    },
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d5\u05e6\u05e8"
    },
    "category_name": {
      "type": "string",
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4"
    },
    "variant_label": {
      "type": "string",
      "description": "\u05de\u05d9\u05d3\u05d4 / \u05e6\u05d1\u05e2 (\u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9)"
    },
    "sku": {
      "type": "string"
    },
    "barcode": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED"
      ],
      "default": "PENDING",
      "description": "PENDING = \u05de\u05de\u05ea\u05d9\u05df \u05dc\u05d0\u05d9\u05e9\u05d5\u05e8 \u05d1\u05e2\u05dc \u05d4\u05e8\u05e9\u05ea, APPROVED = \u05e0\u05d5\u05e1\u05e3 \u05dc\u05e7\u05d8\u05dc\u05d5\u05d2 \u05d4\u05e8\u05e9\u05ea, REJECTED = \u05e0\u05e9\u05d0\u05e8 \u05de\u05e7\u05d5\u05de\u05d9 \u05d1\u05de\u05d7\u05e1\u05df"
    },
    "linked_variant_id": {
      "type": "string",
      "description": "\u05d4\u05d5\u05e8\u05d9\u05d0\u05e6\u05d9\u05d4 \u05e9\u05dc \u05d4\u05e8\u05e9\u05ea \u05e9\u05e0\u05d5\u05e6\u05e8\u05d4 \u05d1\u05e2\u05ea \u05d4\u05d0\u05d9\u05e9\u05d5\u05e8 \u2014 \u05e0\u05e9\u05de\u05e8 \u05de\u05d9\u05d3 \u05d0\u05d7\u05e8\u05d9 \u05d4\u05d9\u05e6\u05d9\u05e8\u05d4"
    },
    "linked_group_id": {
      "type": "string",
      "description": "\u05d4\u05de\u05d5\u05e6\u05e8 (ProductGroup) \u05e9\u05e0\u05d5\u05e6\u05e8 \u05d1\u05e7\u05d8\u05dc\u05d5\u05d2 \u05d4\u05e8\u05e9\u05ea \u05d1\u05e2\u05ea \u05d4\u05d0\u05d9\u05e9\u05d5\u05e8"
    },
    "copied_branch_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e1\u05e0\u05d9\u05e4\u05d9\u05dd \u05e9\u05db\u05d1\u05e8 \u05e7\u05d9\u05d1\u05dc\u05d5 \u05e2\u05d5\u05ea\u05e7 \u05e9\u05dc \u05d4\u05de\u05d5\u05e6\u05e8 \u2014 \u05d1\u05d0\u05d9\u05e9\u05d5\u05e8 \u05d7\u05d5\u05d6\u05e8 \u05dc\u05d0 \u05de\u05e2\u05ea\u05d9\u05e7\u05d9\u05dd \u05e9\u05d5\u05d1"
    },
    "tenant_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d1\u05e2\u05dc \u05d4\u05e8\u05e9\u05ea \u2014 \u05e9\u05d3\u05d4 \u05d1\u05e2\u05dc\u05d5\u05ea \u05dc\u05d4\u05e8\u05e9\u05d0\u05d5\u05ea"
    },
    "station_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d7\u05e9\u05d1\u05d5\u05df \u05d4\u05de\u05d7\u05e1\u05df \u2014 \u05e9\u05d3\u05d4 \u05d1\u05e2\u05dc\u05d5\u05ea \u05dc\u05d4\u05e8\u05e9\u05d0\u05d5\u05ea"
    }
  },
  "required": [
    "warehouse_id",
    "name",
    "status"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.station_email": "{{user.email}}"
        },
        {
          "data.tenant_email": "{{user.email}}"
        }
      ]
    }
  }
}