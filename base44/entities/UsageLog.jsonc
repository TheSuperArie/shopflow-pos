{
  "name": "UsageLog",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "\u05d4\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05e9\u05dc \u05d4\u05d7\u05e9\u05d1\u05d5\u05df \u05e9\u05e0\u05db\u05e0\u05e1 \u05dc\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4"
    },
    "user_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05db\u05e4\u05d9 \u05e9\u05de\u05d5\u05e4\u05d9\u05e2 \u05d1\u05d7\u05e9\u05d1\u05d5\u05df"
    },
    "login_at": {
      "type": "string",
      "description": "\u05d6\u05de\u05df \u05d4\u05db\u05e0\u05d9\u05e1\u05d4 (ISO)"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "STORE",
        "BRANCH",
        "MASTER"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d7\u05e9\u05d1\u05d5\u05df: \u05d7\u05e0\u05d5\u05ea \u05d9\u05d7\u05d9\u05d3\u05d4, \u05e1\u05e0\u05d9\u05e3 \u05d1\u05e8\u05e9\u05ea, \u05d0\u05d5 \u05d1\u05e2\u05dc \u05e8\u05e9\u05ea"
    },
    "branch_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e1\u05e0\u05d9\u05e3 \u05d0\u05dd \u05d4\u05d7\u05e9\u05d1\u05d5\u05df \u05de\u05d7\u05d5\u05d1\u05e8 \u05dc\u05e8\u05e9\u05ea \u05db\u05e1\u05e0\u05d9\u05e3"
    },
    "branch_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e1\u05e0\u05d9\u05e3 \u05d0\u05dd \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9"
    },
    "tenant_email": {
      "type": "string",
      "description": "\u05d4\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05e9\u05dc \u05d1\u05e2\u05dc \u05d4\u05e8\u05e9\u05ea \u05e9\u05d0\u05dc\u05d9\u05d5 \u05de\u05e9\u05d5\u05d9\u05da \u05d4\u05d7\u05e9\u05d1\u05d5\u05df (\u05d0\u05dd \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9)"
    }
  },
  "required": [
    "user_email",
    "login_at"
  ]
}